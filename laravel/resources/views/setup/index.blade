<script>
function toggleDbFields() {
    var mode = document.querySelector('input[name="db_connection"]:checked');
    var el = document.getElementById('mysqlFields');
    if (el) el.style.display = (mode && mode.value === 'sqlite') ? 'none' : 'block';
}
document.addEventListener('DOMContentLoaded', toggleDbFields);
</script>
@endsection
