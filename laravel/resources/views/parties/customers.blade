        </form>
    </div>
</div>

<script>
window.openEditCustomerModal = function(id, name, phone, email, address) {
    document.getElementById('editCustomerForm').action = '{{ url('/customers') }}/' + id;
    document.getElementById('editCustName').value = name || '';
    document.getElementById('editCustPhone').value = phone || '';
    document.getElementById('editCustEmail').value = email || '';
    document.getElementById('editCustAddress').value = address || '';
    var m = document.getElementById('editCustomerModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
};
window.closeEditCustomerModal = function() {
    var m = document.getElementById('editCustomerModal');
    if (m) {
        m.classList.add('hidden');
        m.classList.remove('flex');
    }
};
</script>
@endsection
