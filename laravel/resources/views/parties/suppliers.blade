<script>
window.openEditSupplierModal = function(id, name, phone, email, address) {
    document.getElementById('editSupplierForm').action = '{{ url('/suppliers') }}/' + id;
    document.getElementById('editSupName').value = name || '';
    document.getElementById('editSupPhone').value = phone || '';
    document.getElementById('editSupEmail').value = email || '';
    document.getElementById('editSupAddress').value = address || '';
    var m = document.getElementById('editSupplierModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
};
window.closeEditSupplierModal = function() {
    var m = document.getElementById('editSupplierModal');
    if (m) {
        m.classList.add('hidden');
        m.classList.remove('flex');
    }
};
</script>
@endsection
