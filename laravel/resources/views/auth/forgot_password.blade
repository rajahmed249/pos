        @if($recStep === 'request')
            <form method="POST" action="{{ route('password.send_code') }}" class="space-y-3">
                @csrf
                <select id="recoverChannelSelect" name="channel" aria-label="Delivery Channel"
                        class="w-full px-4 py-3 rounded-[14px] text-sm text-white bg-[#0e132d]/85 border border-indigo-300/20 focus:outline-none focus:border-violet-400/75">
                    <option value="email" class="bg-[#0e132d]">Send Verification Code via Email</option>
                    <option value="sms" class="bg-[#0e132d]">Send Verification Code via Mobile SMS</option>
                </select>

                <div class="relative flex items-center">
                    <i class="far fa-envelope text-indigo-200/80 text-base absolute left-4 pointer-events-none"></i>
                    <input id="recoverIdentifierInput" name="identifier" type="text" value="{{ old('identifier', 'rajahmed249@gmail.com') }}" required
                           aria-label="Registered email or mobile number"
                           placeholder="Registered email address"
                           class="w-full pl-11 pr-4 py-3 rounded-[14px] text-sm text-white placeholder:text-indigo-100/65 bg-[#0e132d]/85 border border-indigo-300/20 focus:outline-none focus:border-violet-400/75 focus:ring-2 focus:ring-violet-500/25 transition-all">
                </div>

                <button type="submit" style="background: linear-gradient(90deg, #3b82f6 0%, #7c3aed 52%, #e052f5 100%);"
                        class="w-full py-3 px-5 rounded-[14px] text-[15px] font-semibold text-white shadow-[0_10px_28px_rgba(124,58,237,0.45)] hover:brightness-110 transition-all cursor-pointer">
                    Send Recovery Code
                </button>
            </form>
            <script>
                (function () {
                    var sel = document.getElementById('recoverChannelSelect');
                    var inp = document.getElementById('recoverIdentifierInput');
                    if (!sel || !inp) return;
                    sel.addEventListener('change', function () {
                        if (sel.value === 'sms') {
                            if (inp.value.indexOf('@') !== -1) inp.value = '';
                            inp.placeholder = 'Registered mobile number (e.g. 01674297522)';
                        } else {
                            if (!inp.value) inp.value = 'rajahmed249@gmail.com';
                            inp.placeholder = 'Registered email address';
                        }
                    });
                })();
            </script>
        @elseif($recStep === 'verify')
            <form method="POST" action="{{ route('password.verify_code') }}" class="space-y-3">
                @csrf
                <input type="hidden" name="identifier" value="{{ $recIdentifier }}">

                <div class="relative flex items-center">
                    <i class="fas fa-key text-indigo-200/80 text-sm absolute left-4 pointer-events-none"></i>
                    <input name="code" type="text" maxlength="6" pattern="\d{6}" required autofocus
                           aria-label="6-digit verification code"
