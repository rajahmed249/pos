                <button type="button" onclick="var p=document.getElementById('password');var ic=this.querySelector('i');if(p.type==='password'){p.type='text';ic.classList.remove('fa-eye');ic.classList.add('fa-eye-slash');}else{p.type='password';ic.classList.remove('fa-eye-slash');ic.classList.add('fa-eye');}"
                        aria-label="Toggle password visibility"
                        class="absolute right-3.5 text-indigo-200/80 hover:text-white p-1 cursor-pointer transition-colors">
                    <i class="far fa-eye text-base"></i>
                </button>
