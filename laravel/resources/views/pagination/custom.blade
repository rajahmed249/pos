@if ($paginator->hasPages() || (method_exists($paginator, 'total') && $paginator->total() > 0))
    @php
        $relUrl = static function (?string $url): string {
            if (!$url) {
                return '#';
            }
            $relative = preg_replace('#^https?://[^/]+#i', '', $url);
            return $relative !== '' && $relative !== null ? $relative : $url;
        };
        $currentPage = $paginator->currentPage();
        $lastPage = method_exists($paginator, 'lastPage') ? max(1, (int) $paginator->lastPage()) : $currentPage;
        $firstItem = method_exists($paginator, 'firstItem') ? ($paginator->firstItem() ?? 0) : 1;
        $lastItem = method_exists($paginator, 'lastItem') ? ($paginator->lastItem() ?? 0) : 0;
        $totalItems = method_exists($paginator, 'total') ? (int) $paginator->total() : 0;
        $perPage = method_exists($paginator, 'perPage') ? (int) $paginator->perPage() : (int) request('limit', 10);

        $window = 2;
        $startPage = max(1, $currentPage - $window);
        $endPage = min($lastPage, $currentPage + $window);
        $existingQuery = request()->except(['page', 'limit']);
    @endphp
    <style>
