    <nav role="navigation" aria-label="{{ __('Pagination Navigation') }}" class="yit-pag-wrap">
        {{-- Left: Range Info --}}
        <div class="yit-pag-info">
            @if (method_exists($paginator, 'total'))
                <strong>{{ number_format($firstItem) }}</strong> – <strong>{{ number_format($lastItem) }}</strong> of <strong>{{ number_format($totalItems) }}</strong>
            @else
                Page <strong>{{ $currentPage }}</strong>
            @endif
        </div>

        {{-- Center: « ‹ 1 ... window ... N › » --}}
        @if ($paginator->hasPages())
            <div class="yit-pag-nav">
                @if ($paginator->onFirstPage())
                    <span class="yit-pag-btn is-disabled" aria-disabled="true" title="First Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m11 17-5-5 5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="m18 17-5-5 5-5"/></svg>
                    </span>
                    <span class="yit-pag-btn is-disabled" aria-disabled="true" title="Previous Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </span>
                @else
                    <a href="{{ $relUrl($paginator->url(1)) }}" class="yit-pag-btn" title="First Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m11 17-5-5 5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="m18 17-5-5 5-5"/></svg>
                    </a>
                    <a href="{{ $relUrl($paginator->previousPageUrl()) }}" rel="prev" class="yit-pag-btn" title="Previous Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    </a>
                @endif

                @if ($startPage > 1)
                    <a href="{{ $relUrl($paginator->url(1)) }}" class="yit-pag-btn">1</a>
                    @if ($startPage > 2)
                        <span class="yit-pag-dots">&hellip;</span>
                    @endif
                @endif

                @for ($p = $startPage; $p <= $endPage; $p++)
                    @if ($p === $currentPage)
                        <span class="yit-pag-btn is-active" aria-current="page">{{ $p }}</span>
                    @else
                        <a href="{{ $relUrl($paginator->url($p)) }}" class="yit-pag-btn">{{ $p }}</a>
                    @endif
                @endfor

                @if ($endPage < $lastPage)
                    @if ($endPage < $lastPage - 1)
                        <span class="yit-pag-dots">&hellip;</span>
                    @endif
                    <a href="{{ $relUrl($paginator->url($lastPage)) }}" class="yit-pag-btn">{{ $lastPage }}</a>
                @endif

                @if ($paginator->hasMorePages())
                    <a href="{{ $relUrl($paginator->nextPageUrl()) }}" rel="next" class="yit-pag-btn" title="Next Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </a>
                    <a href="{{ $relUrl($paginator->url($lastPage)) }}" class="yit-pag-btn" title="Last Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m13 17 5-5-5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="m6 17 5-5-5-5"/></svg>
                    </a>
                @else
                    <span class="yit-pag-btn is-disabled" aria-disabled="true" title="Next Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </span>
                    <span class="yit-pag-btn is-disabled" aria-disabled="true" title="Last Page">
                        <svg class="yit-pag-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="m13 17 5-5-5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="m6 17 5-5-5-5"/></svg>
                    </span>
                @endif
            </div>
        @endif

        {{-- Right: Show [10/20/50/100] + Go [n] [Go] --}}
        <div class="yit-pag-controls">
            <form method="GET" action="{{ url()->current() }}" class="yit-pag-ctrl-group">
                @foreach ($existingQuery as $qKey => $qVal)
                    @if (is_array($qVal))
                        @foreach ($qVal as $subVal)
                            <input type="hidden" name="{{ $qKey }}[]" value="{{ $subVal }}">
                        @endforeach
                    @else
                        <input type="hidden" name="{{ $qKey }}" value="{{ $qVal }}">
                    @endif
                @endforeach
                <input type="hidden" name="page" value="1">
                <label for="pagLimitSelect">Show:</label>
                <select id="pagLimitSelect" name="limit" onchange="this.form.submit()" class="yit-pag-select">
                    @foreach ([10, 20, 50, 100] as $opt)
                        <option value="{{ $opt }}" {{ $perPage === $opt ? 'selected' : '' }}>{{ $opt }}</option>
                    @endforeach
                </select>
            </form>

            @if ($lastPage > 1)
                <form method="GET" action="{{ url()->current() }}" class="yit-pag-ctrl-group">
                    @foreach ($existingQuery as $qKey => $qVal)
                        @if (is_array($qVal))
                            @foreach ($qVal as $subVal)
                                <input type="hidden" name="{{ $qKey }}[]" value="{{ $subVal }}">
                            @endforeach
                        @else
                            <input type="hidden" name="{{ $qKey }}" value="{{ $qVal }}">
                        @endif
                    @endforeach
                    <input type="hidden" name="limit" value="{{ $perPage }}">
                    <label for="pagGoInput">Go:</label>
                    <input id="pagGoInput" type="number" name="page" min="1" max="{{ $lastPage }}" value="{{ $currentPage }}" class="yit-pag-input">
                    <button type="submit" class="yit-pag-go">Go</button>
                </form>
            @endif
        </div>
    </nav>
@endif
