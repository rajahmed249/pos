<script>
(function() {
    var cur = @json($cur);
    window.syncEstimateCustomer = function() {
        var sel = document.getElementById('estCustomerSelect');
        var inp = document.getElementById('estCustomerName');
        if (!sel || !inp) return;
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.dataset.name) {
            inp.value = opt.dataset.name;
        }
    };
    window.calcEstimatePreview = function() {
        var qty = Number(document.getElementById('estQtyInput')?.value || 0);
        var rate = Number(document.getElementById('estRateInput')?.value || 0);
        var disc = Number(document.getElementById('estDiscountInput')?.value || 0);
        var total = Math.max(0, (qty * rate) - disc);
        var el = document.getElementById('estTotalPreview');
        if (el) el.textContent = cur + total.toFixed(2);
    };
    window.syncEstimateRate = function() {
        var sel = document.getElementById('estProductSelect');
        var rate = document.getElementById('estRateInput');
        if (!sel || !rate) return;
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.dataset.price) {
            rate.value = Number(opt.dataset.price || 0).toFixed(2);
            window.calcEstimatePreview();
        }
    };
    window.syncEstimateRate();
})();
</script>
@endsection
