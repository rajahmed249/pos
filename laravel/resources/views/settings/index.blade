<script>
window.syncSettingsPreview = function() {
    var name = document.getElementById('setShopName')?.value || 'YOUTH IT POS';
    var cur = document.getElementById('setCurrency')?.value || '৳';
    var phone = document.getElementById('setShopPhone')?.value || '';
    var email = document.getElementById('setShopEmail')?.value || '';
    var web = document.getElementById('setShopWebsite')?.value || '';
    var addr = document.getElementById('setShopAddress')?.value || 'Store address';
    var foot = document.getElementById('setInvoiceFooter')?.value || '';
    var layout = document.getElementById('setLayoutMode')?.value || 'comfortable';

    document.getElementById('prevShopName').textContent = name;
    document.getElementById('prevShopAddress').textContent = addr;
    document.getElementById('prevShopPhone').textContent = phone;
    document.getElementById('prevShopEmail').textContent = email;
    document.getElementById('prevShopWebsite').textContent = web;
    document.getElementById('prevBadge').textContent = cur + ' · ' + layout;
    document.getElementById('prevInvoiceFooter').textContent = foot ? ('“' + foot + '”') : '';
};
</script>
