<script>
(function () {
    var activeSaleMenuId = null;

    window.toggleSaleItems = function (saleId, extraCount) {
        var box = document.getElementById('sale-extra-' + saleId);
        var btn = document.getElementById('sale-toggle-' + saleId);
        if (!box || !btn) return;
        var isHidden = box.classList.contains('hidden');
        box.classList.toggle('hidden');
        btn.textContent = isHidden ? 'Show less' : '+' + extraCount + ' more items';
    };

    window.closeSaleActionMenus = function () {
        document.querySelectorAll('.sale-floating-menu').forEach(function (el) {
            el.classList.add('hidden');
        });
        activeSaleMenuId = null;
    };

    window.openSaleActionMenu = function (e, saleId) {
        e.stopPropagation();
        var menu = document.getElementById('sale-menu-' + saleId);
        if (!menu) return;
        if (activeSaleMenuId === saleId && !menu.classList.contains('hidden')) {
            window.closeSaleActionMenus();
            return;
        }
        window.closeSaleActionMenus();
        menu.classList.remove('hidden');
        var rect = e.currentTarget.getBoundingClientRect();
        var menuWidth = 192;
        var menuHeight = menu.offsetHeight || 168;
        var left = Math.max(12, Math.min(rect.right - menuWidth, window.innerWidth - menuWidth - 12));
        var spaceBelow = window.innerHeight - rect.bottom;
        var top = spaceBelow >= menuHeight + 8 ? rect.bottom + 6 : Math.max(12, rect.top - menuHeight - 6);
        menu.style.left = left + 'px';
        menu.style.top = top + 'px';
        activeSaleMenuId = saleId;
    };

    window.openSalePaymentModal = function (saleId, invoiceNo, dueAmount) {
        window.closeSaleActionMenus();
        var form = document.getElementById('salePayForm');
        form.action = '{{ url("/sales") }}/' + saleId + '/payment';
        document.getElementById('salePayInvoice').textContent = invoiceNo;
        document.getElementById('salePayDueText').textContent = '{{ $cur }}' + Number(dueAmount).toFixed(2);
        var amtInput = document.getElementById('salePayAmount');
        amtInput.value = Number(dueAmount).toFixed(2);
        amtInput.max = Number(dueAmount).toFixed(2);
        var modal = document.getElementById('salePayModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeSalePayModal = function () {
        var modal = document.getElementById('salePayModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    window.openSaleDeleteModal = function (saleId, invoiceNo) {
        window.closeSaleActionMenus();
        var form = document.getElementById('saleDeleteForm');
        form.action = '{{ url("/sales") }}/' + saleId;
        document.getElementById('saleDeleteInvoice').textContent = invoiceNo;
        var modal = document.getElementById('saleDeleteModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeSaleDeleteModal = function () {
        var modal = document.getElementById('saleDeleteModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    document.addEventListener('click', window.closeSaleActionMenus);
    window.addEventListener('scroll', window.closeSaleActionMenus, true);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            window.closeSaleActionMenus();
            window.closeSalePayModal();
            window.closeSaleDeleteModal();
        }
    });
})();
</script>
@endsection
