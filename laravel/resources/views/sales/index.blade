                                <div class="text-[10.5px] text-[#64748b] tabular-nums mt-0.5">
                                    {{ $dateText }}@if($timeText) &middot; {{ $timeText }}@endif
                                </div>
                            </td>
                            <td class="py-2.5 px-2.5">
                                <div class="font-semibold text-[#1e293b] leading-tight max-w-[155px] truncate" title="{{ $sale->customer_name ?: ($sale->customer?->name ?: 'Walk-in Customer') }}">
