                <tbody>
                    @forelse($sales as $idx => $sale)
                        @php
                            $due = (float) ($sale->due ?? 0);
                            $paid = (float) ($sale->paid ?? 0);
                            $receivable = (float) ($sale->receivable ?? 0);
                            $purchaseCost = (float) ($sale->purchase_cost ?? 0);
                            if ($purchaseCost <= 0 && $sale->items->isNotEmpty()) {
                                $purchaseCost = (float) $sale->items->sum(fn ($it) => ((float) ($it->product?->purchase_price ?? 0)) * max(1, (int) ($it->quantity ?? 1)));
                            }
                            $profitVal = (float) ($sale->profit ?? 0);
                            if (abs($profitVal) < 0.001 && $purchaseCost > 0) {
                                $profitVal = $receivable - $purchaseCost;
                            }
                            $completed = $due <= 0.009;
                            $saleDt = $sale->date ?? $sale->sale_date ?? $sale->created_at;
                            $dateText = $saleDt ? \Illuminate\Support\Carbon::parse($saleDt)->format('d M Y') : '—';
                            $timeText = ($sale->created_at || $sale->sale_date)
                                ? \Illuminate\Support\Carbon::parse($sale->created_at ?? $sale->sale_date)->format('h:i A')
                                : '';
                            $items = $sale->items;
                            $previewItems = $items->take(3);
                            $extraItems = $items->slice(3);
                        @endphp
                        <tr class="border-b border-[#f1f5f9] hover:bg-[#f8fafc] transition-colors align-top">
