@php
    $companyName = trim((string) ($appSettings['shop_name'] ?? 'YOUTH IT POS'));
    $companyUpper = strtoupper($companyName);
    $youthItPart = str_contains($companyUpper, 'YOUTH IT') ? 'YOUTH IT' : $companyUpper;
    $posPart = str_contains($companyUpper, 'YOUTH IT') ? trim(str_replace('YOUTH IT', '', $companyUpper)) : '';
    $companyAddress = $appSettings['shop_address'] ?? 'Shop No.04, (Ground Floor), 820, Makkha Tower, West Shewrapara, Mirpur, Dhaka-1216';
    $companyPhone = $appSettings['shop_phone'] ?? '01674297522';
    $companyEmail = $appSettings['shop_email'] ?? 'info@youthit.com.bd';
    $companyWebsite = preg_replace('#^https?://#i', '', (string) ($appSettings['shop_website'] ?? 'www.youthit.com.bd'));
    $logoPath = $appSettings['shop_logo'] ?? 'assets/images/logo.jpg';
    $rawQr = (string) ($appSettings['shop_qr'] ?? '');
    $qrPath = ($rawQr && !str_starts_with($rawQr, 'uploads/')) ? $rawQr : 'assets/images/shop_qr.png';

    $calculatedSubtotal = $sale->items->sum('total');
    $totalAmount = (float) ($sale->subtotal > 0 ? $sale->subtotal : $calculatedSubtotal);
    $discount = (float) ($sale->discount ?? 0);
    $vatAmount = (float) ($sale->vat ?? ($sale->tax ?? 0));
    $netPayable = max(0, $sale->receivable > 0 && $vatAmount == 0 ? (float) $sale->receivable : ($totalAmount - $discount + $vatAmount));
    $paid = (float) ($sale->paid ?? 0);
    $due = max(0, $netPayable - $paid);
    $customerOpening = (float) ($sale->customer?->opening_balance ?? 0);
    $previousDue = max(0, $customerOpening - $due);
    $totalDue = $previousDue + $due;
    $paymentTerm = ucfirst(strtolower((string) ($sale->account_name ?: 'Cash')));
    $invoiceDate = ($sale->sale_date && $sale->sale_date->year > 1990)
        ? $sale->sale_date->format('d-m-Y')
        : (($sale->date && $sale->date->year > 1990)
            ? $sale->date->format('d-m-Y')
            : ($sale->created_at?->format('d-m-Y') ?? now()->format('d-m-Y')));

    $numberToWordsBd = function (float $number) use (&$numberToWordsBd): string {
        $dict = [
            0 => 'Zero', 1 => 'One', 2 => 'Two', 3 => 'Three', 4 => 'Four',
            5 => 'Five', 6 => 'Six', 7 => 'Seven', 8 => 'Eight', 9 => 'Nine',
            10 => 'Ten', 11 => 'Eleven', 12 => 'Twelve', 13 => 'Thirteen',
            14 => 'Fourteen', 15 => 'Fifteen', 16 => 'Sixteen', 17 => 'Seventeen',
            18 => 'Eighteen', 19 => 'Nineteen', 20 => 'Twenty', 30 => 'Thirty',
            40 => 'Forty', 50 => 'Fifty', 60 => 'Sixty', 70 => 'Seventy',
            80 => 'Eighty', 90 => 'Ninety', 100 => 'Hundred',
        ];
        $twoDigits = function (int $n) use ($dict): string {
            if ($n < 21) return $dict[$n] ?? '';
            $tens = (int) (floor($n / 10) * 10);
            $units = $n % 10;
            return $units ? ($dict[$tens] . '-' . $dict[$units]) : $dict[$tens];
        };
        $integerPart = (int) floor(max(0, $number));
        if ($integerPart === 0) return 'Zero';
        $crore = (int) floor($integerPart / 10000000);
        $lac = (int) floor(($integerPart % 10000000) / 100000);
        $thousand = (int) floor(($integerPart % 100000) / 1000);
        $hundred = (int) floor(($integerPart % 1000) / 100);
        $rest = $integerPart % 100;
        $parts = [];
        if ($crore > 0) $parts[] = $numberToWordsBd($crore) . ' Crore';
        if ($lac > 0) $parts[] = $twoDigits($lac) . ' Lac';
        if ($thousand > 0) $parts[] = $twoDigits($thousand) . ' Thousand';
        if ($hundred > 0) $parts[] = $dict[$hundred] . ' Hundred';
        if ($rest > 0) $parts[] = count($parts) > 0 ? 'and ' . $twoDigits($rest) : $twoDigits($rest);
        return implode(' ', $parts);
    };
    $totalInWords = $numberToWordsBd($netPayable) . ' Taka Only';
@endphp

