<script>
(function() {
    var cur = @json($cur);
    var suppliers = [];
    var products = [];
    try { suppliers = JSON.parse(document.getElementById('purchaseSuppliersData').textContent || '[]'); } catch (e) {}
    try { products = JSON.parse(document.getElementById('purchaseProductsData').textContent || '[]'); } catch (e) {}

    var cart = [];
    var supplierWrap = document.getElementById('purchaseSupplierWrap');
    var supplierSearch = document.getElementById('purchaseSupplierSearch');
    var supplierDropdown = document.getElementById('purchaseSupplierDropdown');
    var supplierIdInput = document.getElementById('purchaseSupplierId');
    var supplierChip = document.getElementById('purchaseSupplierChip');

    var productWrap = document.getElementById('purchaseProductWrap');
    var productSearch = document.getElementById('purchaseProductSearch');
    var productDropdown = document.getElementById('purchaseProductDropdown');

    var cartTbody = document.getElementById('purchaseCartTbody');
    var cartBadge = document.getElementById('purchaseCartBadge');
    var hiddenInputs = document.getElementById('purchaseCartHiddenInputs');
    var discountInput = document.getElementById('purchaseDiscountInput');
    var paidInput = document.getElementById('purchasePaidInput');
    var fullPaidBtn = document.getElementById('purchaseFullPaidBtn');
    var errorBox = document.getElementById('purchaseClientError');

    function showError(msg) {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearError() {
        if (errorBox) errorBox.classList.add('hidden');
    }

    function renderSupplierDropdown() {
        if (!supplierDropdown) return;
        var q = (supplierSearch.value || '').trim().toLowerCase();
        var active = suppliers.find(function(s) { return String(s.id) === String(supplierIdInput.value); });
        var list = (!q || (active && active.name.toLowerCase() === q))
            ? suppliers.slice(0, 12)
            : suppliers.filter(function(s) {
                return s.name.toLowerCase().includes(q) ||
                    (s.phone || '').toLowerCase().includes(q) ||
                    (s.email || '').toLowerCase().includes(q);
            }).slice(0, 12);

        supplierDropdown.innerHTML = '';
        if (list.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'px-3.5 py-3 text-xs text-slate-400';
            empty.textContent = 'No matching suppliers found.';
            supplierDropdown.appendChild(empty);
            return;
        }
        list.forEach(function(s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-full px-3.5 py-2 text-left text-xs hover:bg-indigo-50 flex items-center justify-between gap-2 cursor-pointer ' +
                (String(s.id) === String(supplierIdInput.value) ? 'bg-indigo-50/70 font-semibold text-indigo-800' : 'text-slate-700');
            var nameSpan = document.createElement('span');
            nameSpan.className = 'truncate';
            nameSpan.textContent = s.name;
            var metaSpan = document.createElement('span');
            metaSpan.className = 'text-[11px] text-slate-400 font-mono shrink-0';
            metaSpan.textContent = s.phone || s.email || '';
            btn.appendChild(nameSpan);
            btn.appendChild(metaSpan);
            btn.addEventListener('click', function() {
                supplierIdInput.value = s.id;
                supplierSearch.value = s.name;
                if (supplierChip) {
                    supplierChip.textContent = s.name;
                    supplierChip.classList.remove('hidden');
                }
                supplierDropdown.classList.add('hidden');
                clearError();
            });
            supplierDropdown.appendChild(btn);
        });
    }

    function getFilteredProducts() {
        var q = (productSearch.value || '').trim().toLowerCase();
        if (!q) return products.slice(0, 15);
        return products.filter(function(p) {
            return p.name.toLowerCase().includes(q) ||
                (p.sku || '').toLowerCase().includes(q) ||
                (p.barcode || '').toLowerCase().includes(q);
        }).slice(0, 15);
    }

    function renderProductDropdown() {
        if (!productDropdown) return;
        var list = getFilteredProducts();
        productDropdown.innerHTML = '';
        if (list.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'px-4 py-4 text-xs text-slate-400';
            empty.textContent = 'No matching products found.';
            productDropdown.appendChild(empty);
            return;
        }
        list.forEach(function(p) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-full px-4 py-2.5 text-left text-xs hover:bg-indigo-50 flex items-center justify-between gap-3 cursor-pointer';

            var left = document.createElement('div');
            left.className = 'min-w-0';
            var title = document.createElement('div');
            title.className = 'font-semibold text-slate-900 truncate';
            title.textContent = p.name;
            var sub = document.createElement('div');
            sub.className = 'text-[11px] text-slate-400 font-mono';
            sub.textContent = (p.sku || 'No SKU') + (p.barcode ? (' · ' + p.barcode) : '') + ' · Stock: ' + p.stock;
            left.appendChild(title);
            left.appendChild(sub);

            var right = document.createElement('div');
            right.className = 'text-right shrink-0';
            var cost = document.createElement('div');
            cost.className = 'font-mono font-bold text-indigo-700 tabular-nums';
            cost.textContent = cur + Number(p.purchase_price || 0).toFixed(2);
            var addHint = document.createElement('div');
            addHint.className = 'text-[10px] text-emerald-600 font-semibold';
            addHint.textContent = '+ Add';
            right.appendChild(cost);
            right.appendChild(addHint);

            btn.appendChild(left);
            btn.appendChild(right);
            btn.addEventListener('click', function() {
                addProductToCart(p);
            });
            productDropdown.appendChild(btn);
        });
    }

    function addProductToCart(product) {
        clearError();
        var existing = cart.find(function(item) { return item.product_id === product.id; });
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({
                product_id: product.id,
                name: product.name,
                sku: product.sku || '',
                stock: Number(product.stock || 0),
                price: Number(product.purchase_price || 0),
                quantity: 1
            });
        }
        productSearch.value = '';
        productDropdown.classList.add('hidden');
        renderCart();
    }

    function updateSummaryAndHiddenInputs() {
        var subtotal = cart.reduce(function(sum, it) { return sum + (it.price * it.quantity); }, 0);
        var disc = Math.max(0, Math.min(subtotal, Number(discountInput.value || 0)));
        var total = Math.max(0, subtotal - disc);
        var paid = Math.max(0, Math.min(total, Number(paidInput.value || 0)));
        var due = Math.max(0, total - paid);

        document.getElementById('purchaseSubtotalText').textContent = cur + subtotal.toFixed(2);
        document.getElementById('purchaseTotalText').textContent = cur + total.toFixed(2);

        if (total > 0) {
            fullPaidBtn.classList.remove('hidden');
            document.getElementById('purchaseDueRow').classList.remove('hidden');
            var dueEl = document.getElementById('purchaseDueText');
            dueEl.textContent = cur + due.toFixed(2);
            dueEl.className = 'font-mono font-bold tabular-nums ' + (due > 0 ? 'text-rose-600' : 'text-emerald-600');
        } else {
            fullPaidBtn.classList.add('hidden');
            document.getElementById('purchaseDueRow').classList.add('hidden');
        }

        if (cart.length > 0) {
            cartBadge.classList.remove('hidden');
            cartBadge.textContent = cart.length + (cart.length === 1 ? ' product' : ' products') + ' in cart';
        } else {
            cartBadge.classList.add('hidden');
        }

        hiddenInputs.innerHTML = '';
        cart.forEach(function(item, idx) {
            [
                ['product_id', item.product_id],
                ['quantity', item.quantity],
                ['price', item.price]
            ].forEach(function(pair) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'items[' + idx + '][' + pair[0] + ']';
                inp.value = String(pair[1]);
                hiddenInputs.appendChild(inp);
            });
        });
    }

    function renderCart() {
        cartTbody.innerHTML = '';
        if (cart.length === 0) {
            var emptyTr = document.createElement('tr');
            var emptyTd = document.createElement('td');
            emptyTd.colSpan = 6;
            emptyTd.className = 'px-4 py-10 text-center text-slate-400 text-xs font-medium';
            emptyTd.textContent = 'Cart is empty. Search and add products.';
            emptyTr.appendChild(emptyTd);
            cartTbody.appendChild(emptyTr);
            updateSummaryAndHiddenInputs();
            return;
        }

        cart.forEach(function(item, idx) {
            var tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50/70';

            var tdSl = document.createElement('td');
            tdSl.className = 'px-4 py-2.5 font-mono text-xs text-slate-500 tabular-nums';
            tdSl.textContent = String(idx + 1);

            var tdProd = document.createElement('td');
            tdProd.className = 'px-4 py-2.5';
            var pName = document.createElement('div');
            pName.className = 'font-semibold text-slate-900';
            pName.textContent = item.name;
            var pMeta = document.createElement('div');
            pMeta.className = 'text-[11px] text-slate-400 font-mono';
            pMeta.textContent = (item.sku ? item.sku + ' · ' : '') + 'In stock: ' + item.stock;
            tdProd.appendChild(pName);
            tdProd.appendChild(pMeta);

            var tdRate = document.createElement('td');
            tdRate.className = 'px-4 py-2.5 text-right';
            var rateInp = document.createElement('input');
            rateInp.type = 'number';
            rateInp.step = '0.01';
            rateInp.min = '0';
            rateInp.value = String(item.price);
            rateInp.className = 'w-28 ml-auto px-2.5 py-1.5 text-right font-mono text-xs border border-slate-200 rounded-lg bg-slate-50/60 focus:bg-white focus:border-indigo-500 outline-none tabular-nums';
            tdRate.appendChild(rateInp);

            var tdQty = document.createElement('td');
            tdQty.className = 'px-4 py-2.5 text-center';
            var qtyInp = document.createElement('input');
            qtyInp.type = 'number';
            qtyInp.min = '1';
            qtyInp.value = String(item.quantity);
            qtyInp.className = 'w-20 mx-auto px-2.5 py-1.5 text-center font-mono text-xs border border-slate-200 rounded-lg bg-slate-50/60 focus:bg-white focus:border-indigo-500 outline-none tabular-nums';
            tdQty.appendChild(qtyInp);

            var tdSub = document.createElement('td');
            tdSub.className = 'px-4 py-2.5 text-right font-mono text-xs font-bold text-slate-900 tabular-nums whitespace-nowrap';
            tdSub.textContent = cur + (item.price * item.quantity).toFixed(2);

            rateInp.addEventListener('input', function() {
                item.price = Math.max(0, Number(rateInp.value || 0));
                tdSub.textContent = cur + (item.price * item.quantity).toFixed(2);
                updateSummaryAndHiddenInputs();
            });
            qtyInp.addEventListener('input', function() {
                item.quantity = Math.max(1, Math.floor(Number(qtyInp.value || 1)));
                tdSub.textContent = cur + (item.price * item.quantity).toFixed(2);
                updateSummaryAndHiddenInputs();
            });

            var tdAct = document.createElement('td');
            tdAct.className = 'px-4 py-2.5 text-center';
            var rmBtn = document.createElement('button');
            rmBtn.type = 'button';
            rmBtn.className = 'px-2 py-1 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 cursor-pointer';
            rmBtn.textContent = 'Remove';
            rmBtn.addEventListener('click', function() {
                cart = cart.filter(function(c) { return c.product_id !== item.product_id; });
                renderCart();
            });
            tdAct.appendChild(rmBtn);

            tr.appendChild(tdSl);
            tr.appendChild(tdProd);
            tr.appendChild(tdRate);
            tr.appendChild(tdQty);
            tr.appendChild(tdSub);
            tr.appendChild(tdAct);
            cartTbody.appendChild(tr);
        });
        updateSummaryAndHiddenInputs();
    }

    if (supplierSearch) {
        supplierSearch.addEventListener('focus', function() {
            renderSupplierDropdown();
            supplierDropdown.classList.remove('hidden');
        });
        supplierSearch.addEventListener('input', function() {
            renderSupplierDropdown();
            supplierDropdown.classList.remove('hidden');
        });
    }

    if (productSearch) {
        productSearch.addEventListener('focus', function() {
            renderProductDropdown();
            productDropdown.classList.remove('hidden');
        });
        productSearch.addEventListener('input', function() {
            renderProductDropdown();
            productDropdown.classList.remove('hidden');
        });
        productSearch.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                var list = getFilteredProducts();
                if (list.length > 0) {
                    e.preventDefault();
                    addProductToCart(list[0]);
                }
            }
        });
    }

    if (discountInput) discountInput.addEventListener('input', updateSummaryAndHiddenInputs);
    if (paidInput) paidInput.addEventListener('input', updateSummaryAndHiddenInputs);
    if (fullPaidBtn) {
        fullPaidBtn.addEventListener('click', function() {
            var subtotal = cart.reduce(function(sum, it) { return sum + (it.price * it.quantity); }, 0);
            var disc = Math.max(0, Math.min(subtotal, Number(discountInput.value || 0)));
            var total = Math.max(0, subtotal - disc);
            paidInput.value = total.toFixed(2);
            updateSummaryAndHiddenInputs();
        });
    }

    document.getElementById('multiPurchaseForm').addEventListener('submit', function(e) {
        if (!supplierIdInput.value) {
            e.preventDefault();
            showError('Please select a supplier first.');
            return;
        }
        if (cart.length === 0) {
            e.preventDefault();
            showError('Cart is empty. Search and add at least one product.');
            return;
        }
        updateSummaryAndHiddenInputs();
    });

    document.addEventListener('mousedown', function(e) {
        if (supplierWrap && !supplierWrap.contains(e.target)) supplierDropdown.classList.add('hidden');
        if (productWrap && !productWrap.contains(e.target)) productDropdown.classList.add('hidden');
    });

    window.openSupplierPayModal = function(id, inv, supplier, due) {
        var form = document.getElementById('supPayForm');
        form.action = '{{ url('/purchases') }}/' + id + '/payment';
        document.getElementById('supPaySubtitle').textContent = inv + ' · ' + supplier + ' (Due: ' + cur + Number(due).toFixed(2) + ')';
        document.getElementById('supPayAmount').value = Number(due).toFixed(2);
        document.getElementById('supPayAmount').max = Number(due).toFixed(2);
        var modal = document.getElementById('supplierPayModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };
    window.closeSupplierPayModal = function() {
        var modal = document.getElementById('supplierPayModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    renderCart();
})();
</script>
@endsection
