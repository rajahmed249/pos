    $cur = $appSettings['currency'] ?? '৳';
    $pageTotal = (float) $purchases->getCollection()->sum('total');
    $pagePaid = (float) $purchases->getCollection()->sum('paid');
    $pageDue = (float) $purchases->getCollection()->sum('due');

    $suppliersJson = $suppliers->map(fn ($s) => [
        'id' => $s->id,
        'name' => $s->name,
        'phone' => $s->phone ?? '',
        'email' => $s->email ?? '',
    ])->values();

    $productsJson = $products->map(fn ($p) => [
        'id' => $p->id,
        'name' => $p->name,
        'sku' => $p->sku ?? '',
        'barcode' => $p->barcode ?? '',
        'stock' => (int) ($p->stock_quantity ?? $p->quantity ?? 0),
        'purchase_price' => (float) ($p->purchase_price ?? 0),
    ])->values();
