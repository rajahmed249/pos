                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Date *</label>
                    <input type="date" required name="transaction_date" value="{{ date('Y-m-d') }}"
                           class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl outline-none focus:border-indigo-500">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Note (Optional)</label>
                <input type="text" name="description" placeholder="e.g. Cash deposited into bank"
                       class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl outline-none focus:border-indigo-500">
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeAccountTransferModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer">Cancel</button>
                <button type="submit" style="background: linear-gradient(135deg, #4f46e5, #7c3aed);" class="px-5 py-2 rounded-xl text-xs font-semibold text-white cursor-pointer">Transfer Now</button>
            </div>
        </form>
    </div>
</div>

{{-- Account History Modal --}}
<div id="accountHistoryModal" onclick="closeAccountHistoryModal()" class="fixed inset-0 z-[120] bg-slate-950/55 backdrop-blur-xs hidden items-center justify-center p-4">
    <div onclick="event.stopPropagation()" class="w-full max-w-2xl max-h-[88vh] flex flex-col bg-white rounded-2xl border border-slate-200 shadow-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
            <div>
                <h3 class="font-display text-base font-bold text-slate-900">Account Transaction History</h3>
                <p id="accHistorySubtitle" class="text-xs text-slate-500 mt-0.5"></p>
            </div>
            <button type="button" onclick="closeAccountHistoryModal()" class="text-slate-400 hover:text-slate-700 p-1 cursor-pointer text-lg leading-none">&times;</button>
        </div>
        <div class="grid grid-cols-2 gap-3 p-4 bg-slate-50/50 border-b border-slate-100 text-xs">
            <div class="rounded-xl bg-white border border-slate-200 px-3 py-2">
                <div class="text-[10px] font-semibold uppercase text-slate-500">Opening Balance</div>
                <div id="accHistoryOpening" class="font-mono font-bold text-slate-800 tabular-nums mt-0.5"></div>
            </div>
            <div class="rounded-xl bg-emerald-50 border border-emerald-200/70 px-3 py-2">
                <div class="text-[10px] font-semibold uppercase text-emerald-700">Current Balance</div>
                <div id="accHistoryBalance" class="font-mono font-bold text-emerald-800 tabular-nums mt-0.5"></div>
            </div>
        </div>
        <div class="overflow-y-auto flex-1">
            <table class="w-full text-xs text-left">
                <thead class="bg-slate-50 text-[10.5px] uppercase tracking-wider text-slate-500 border-b border-slate-200 sticky top-0">
                    <tr>
                        <th class="px-4 py-2.5 font-semibold">Date</th>
                        <th class="px-4 py-2.5 font-semibold">Type</th>
                        <th class="px-4 py-2.5 font-semibold">Description</th>
                        <th class="px-4 py-2.5 font-semibold text-right">Amount</th>
                    </tr>
                </thead>
                <tbody id="accHistoryTbody" class="divide-y divide-slate-100"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    var curSymbol = @json($cur);
    var activeAccount = null;
    var activeAccountId = null;
    var dropdown = document.getElementById('accountFloatingDropdown');

    window.closeAccountActionMenu = function() {
        if (dropdown) dropdown.classList.add('hidden');
        activeAccountId = null;
    };

    window.openAccountActionMenu = function(e, accId) {
        e.stopPropagation();
        var dataEl = document.getElementById('account-data-' + accId);
        if (!dataEl || !dropdown) return;

        if (!dropdown.classList.contains('hidden') && activeAccountId === accId) {
            window.closeAccountActionMenu();
            return;
        }

        activeAccountId = accId;
        activeAccount = dataEl.dataset;

        dropdown.classList.remove('hidden');
        var rect = e.currentTarget.getBoundingClientRect();
        var menuWidth = 192;
        var left = Math.min(window.innerWidth - menuWidth - 12, Math.max(12, rect.right - menuWidth));
        var menuHeight = dropdown.offsetHeight || 175;
        var top = rect.bottom + 6;
        if (top + menuHeight > window.innerHeight - 12) {
            top = Math.max(12, rect.top - menuHeight - 6);
        }
        dropdown.style.left = left + 'px';
        dropdown.style.top = top + 'px';
    };

    window.openAccountTxModal = function(type) {
        if (!activeAccount) return;
        var acc = activeAccount;
        window.closeAccountActionMenu();

        document.getElementById('accTxAccountId').value = acc.id;
        document.getElementById('accTxType').value = type;
        document.getElementById('accTxAccountName').textContent = acc.name;
        document.getElementById('accTxCurrentBal').textContent = curSymbol + Number(acc.balance || 0).toFixed(2);
        document.getElementById('accTxAmount').value = '';
        document.getElementById('accTxNote').value = '';

        var btn = document.getElementById('accTxSubmitBtn');
        if (type === 'deposit') {
            document.getElementById('accTxTitle').textContent = 'Add Balance (+)';
            btn.className = 'px-5 py-2 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 cursor-pointer';
            btn.textContent = 'Add Balance';
        } else {
            document.getElementById('accTxTitle').textContent = 'Withdraw Balance (-)';
            btn.className = 'px-5 py-2 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 cursor-pointer';
            btn.textContent = 'Withdraw Balance';
        }

        var modal = document.getElementById('accountTxModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(function() { document.getElementById('accTxAmount').focus(); }, 40);
    };

    window.closeAccountTxModal = function() {
        var modal = document.getElementById('accountTxModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.openAccountTransferModal = function() {
        if (!activeAccount) return;
        var acc = activeAccount;
        window.closeAccountActionMenu();

        var fromSel = document.getElementById('transferFromSelect');
        var toSel = document.getElementById('transferToSelect');
        if (fromSel) fromSel.value = acc.id;
        if (toSel && toSel.options.length > 1) {
            for (var i = 0; i < toSel.options.length; i++) {
                if (toSel.options[i].value !== String(acc.id)) {
                    toSel.selectedIndex = i;
                    break;
                }
            }
        }
        document.getElementById('transferAmountInput').value = '';
        var modal = document.getElementById('accountTransferModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeAccountTransferModal = function() {
        var modal = document.getElementById('accountTransferModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.openAccountHistoryModal = function() {
        if (!activeAccount) return;
        var acc = activeAccount;
        window.closeAccountActionMenu();

        document.getElementById('accHistorySubtitle').textContent = acc.name;
        document.getElementById('accHistoryOpening').textContent = curSymbol + Number(acc.opening || 0).toFixed(2);
        document.getElementById('accHistoryBalance').textContent = curSymbol + Number(acc.balance || 0).toFixed(2);

        var tbody = document.getElementById('accHistoryTbody');
        tbody.innerHTML = '';

        var rows = [];
        try {
            var jsonEl = document.getElementById('account-history-json-' + acc.id);
            if (jsonEl && jsonEl.textContent) {
                rows = JSON.parse(jsonEl.textContent) || [];
            }
        } catch (err) {}

        if (!rows.length) {
            var emptyTr = document.createElement('tr');
            var emptyTd = document.createElement('td');
            emptyTd.colSpan = 4;
            emptyTd.className = 'px-4 py-8 text-center text-slate-500';
            emptyTd.textContent = 'No transactions logged for this account yet.';
            emptyTr.appendChild(emptyTd);
            tbody.appendChild(emptyTr);
        } else {
            rows.forEach(function(tx) {
                var tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50';
                var isDep = tx.type === 'deposit';

                var tdDate = document.createElement('td');
                tdDate.className = 'px-4 py-2.5 font-mono text-slate-600 whitespace-nowrap';
                tdDate.textContent = tx.transaction_date || '—';

                var tdType = document.createElement('td');
                tdType.className = 'px-4 py-2.5 whitespace-nowrap';
                var badge = document.createElement('span');
                badge.className = 'px-2 py-0.5 rounded-full text-[10.5px] font-semibold uppercase ' +
                    (isDep ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700');
                badge.textContent = tx.type || '';
                tdType.appendChild(badge);

                var tdDesc = document.createElement('td');
                tdDesc.className = 'px-4 py-2.5 text-slate-600';
                tdDesc.textContent = tx.description || '—';

                var tdAmt = document.createElement('td');
                tdAmt.className = 'px-4 py-2.5 text-right font-mono font-bold tabular-nums whitespace-nowrap ' +
                    (isDep ? 'text-emerald-700' : 'text-rose-600');
                tdAmt.textContent = (isDep ? '+' : '-') + curSymbol + Number(tx.amount || 0).toFixed(2);

                tr.appendChild(tdDate);
                tr.appendChild(tdType);
                tr.appendChild(tdDesc);
                tr.appendChild(tdAmt);
                tbody.appendChild(tr);
            });
        }

        var modal = document.getElementById('accountHistoryModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeAccountHistoryModal = function() {
        var modal = document.getElementById('accountHistoryModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.openAccountEditModal = function() {
        if (!activeAccount) return;
        var acc = activeAccount;
        window.closeAccountActionMenu();

        var form = document.getElementById('accountEditForm');
        form.action = '{{ url('/accounts') }}/' + acc.id;
        document.getElementById('accEditName').value = acc.name || '';
        document.getElementById('accEditBank').value = acc.bank || '';
        document.getElementById('accEditBranch').value = acc.branch || '';
        document.getElementById('accEditOpening').value = Number(acc.opening || 0).toFixed(2);

        var modal = document.getElementById('accountEditModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(function() { document.getElementById('accEditName').focus(); }, 40);
    };

    window.closeAccountEditModal = function() {
        var modal = document.getElementById('accountEditModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    document.addEventListener('click', function(e) {
        if (dropdown && !dropdown.contains(e.target)) {
            window.closeAccountActionMenu();
        }
    });
    document.addEventListener('scroll', window.closeAccountActionMenu, true);
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeAccountActionMenu();
            window.closeAccountTxModal();
            window.closeAccountTransferModal();
            window.closeAccountHistoryModal();
            window.closeAccountEditModal();
        }
    });
})();
</script>
@endsection
