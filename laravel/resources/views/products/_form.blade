            </div>
            <button type="button" onclick="closeQuickCatalogModal()" class="w-8 h-8 rounded-full bg-slate-200/70 text-slate-500 hover:text-slate-800 flex items-center justify-center cursor-pointer">&times;</button>
        </div>

        <div class="p-6">
            <label id="quickModalLabel" class="block text-xs font-semibold text-[#334155] mb-1.5">Name <span class="text-[#ef4444]">*</span></label>
            <input type="text" id="quickModalInput" required placeholder="Enter name..."
                   class="w-full px-3.5 py-2.5 border-2 border-[#e2e8f0] rounded-[10px] text-sm focus:outline-none focus:border-[#4f46e5]">
            <p id="quickModalHelp" class="text-[11px] text-[#94a3b8] mt-1.5"></p>
        </div>

        <div class="px-6 py-4 bg-[#fafbfc] border-t border-slate-100 flex justify-end gap-2.5">
            <button type="button" onclick="closeQuickCatalogModal()" class="px-5 py-2.5 rounded-lg bg-[#f1f5f9] text-[#475569] text-xs font-semibold cursor-pointer">Cancel</button>
            <button type="submit" style="background: linear-gradient(135deg, #4f46e5, #7c3aed);" class="px-5 py-2.5 rounded-lg text-white text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm cursor-pointer">
                <i class="fas fa-plus"></i> Save &amp; Select
            </button>
        </div>
    </form>
</div>

<script>
const prodCurrency = @js($cur);
let currentQuickKind = null;
const quickConfigs = {
    category: { url: @js(route('categories.store')), selectId: 'prodCategorySelect', icon: 'fas fa-tag', title: 'Add New Category', sub: 'Create a new product category', label: 'Category Name *', placeholder: 'Enter category name...', help: 'Example: Electronics, CCTV Camera, Networking' },
    brand: { url: @js(route('brands.store')), selectId: 'prodBrandSelect', icon: 'fas fa-copyright', title: 'Add New Brand', sub: 'Create a new product brand', label: 'Brand Name *', placeholder: 'Enter brand name...', help: 'Example: Hikvision, Dahua, Dell, HP' },
    warranty: { url: @js(route('warranties.store')), selectId: 'prodWarrantySelect', icon: 'fas fa-shield-alt', title: 'Add New Warranty', sub: 'Create a new warranty period', label: 'Warranty Duration *', placeholder: 'e.g., 1 Year, 6 Months...', help: 'Example: 1 Year, 6 Months, 2 Years, Lifetime' },
    unit: { url: @js(route('units.store')), selectId: 'prodUnitSelect', icon: 'fas fa-cubes', title: 'Add New Unit', sub: 'Create a new measurement unit', label: 'Unit Name *', placeholder: 'e.g., PC, KG, Box...', help: 'Example: PC, KG, Meter, Dozen, Box' }
};

function updateProfitPreview() {
    const pp = parseFloat(document.getElementById('purchasePriceInput')?.value || '0') || 0;
    const sp = parseFloat(document.getElementById('sellingPriceInput')?.value || '0') || 0;
    const profit = sp - pp;
    const margin = sp > 0 ? Math.round((profit / sp) * 100) : 0;
    const badge = document.getElementById('profitPreviewBadge');
    if (!badge) return;
    badge.textContent = `Profit: ${prodCurrency}${profit.toFixed(2)} (${margin}%)`;
    badge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold tabular-nums ' +
        (profit >= 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700');
}

function openQuickCatalogModal(kind) {
    currentQuickKind = kind;
    const cfg = quickConfigs[kind];
    if (!cfg) return;
    document.getElementById('quickModalIcon').className = cfg.icon;
    document.getElementById('quickModalTitle').textContent = cfg.title;
    document.getElementById('quickModalSub').textContent = cfg.sub;
    document.getElementById('quickModalLabel').textContent = cfg.label;
    const inp = document.getElementById('quickModalInput');
    inp.value = '';
    inp.placeholder = cfg.placeholder;
    document.getElementById('quickModalHelp').textContent = cfg.help;
    const m = document.getElementById('quickCatalogModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
    setTimeout(() => inp.focus(), 40);
}

function closeQuickCatalogModal() {
    const m = document.getElementById('quickCatalogModal');
    m.classList.add('hidden');
    m.classList.remove('flex');
}

async function submitQuickCatalogModal(e) {
    e.preventDefault();
    const cfg = quickConfigs[currentQuickKind];
    const val = document.getElementById('quickModalInput').value.trim();
    if (!cfg || !val) return;
    const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const payload = currentQuickKind === 'warranty' ? { name: val, duration: val } : { name: val };
    try {
        const res = await fetch(cfg.url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-TOKEN': token },
            body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('Could not save item.');
        const created = await res.json();
        const select = document.getElementById(cfg.selectId);
        if (select) {
            const opt = document.createElement('option');
            opt.value = created.id;
            opt.textContent = created.duration || created.name;
            opt.selected = true;
            select.appendChild(opt);
        }
        closeQuickCatalogModal();
    } catch (err) {
        if (window.showCenterPopup) window.showCenterPopup('error', 'Save Failed', err.message || 'Unable to save item.');
    }
}

function clearProductImg() {
    document.getElementById('product_image_input').value = '';
    document.getElementById('remove_image_flag').value = '1';
    document.getElementById('product_file_name').textContent = 'No file chosen';
    document.getElementById('product_image_preview').innerHTML = '';
    document.getElementById('product_preview_wrapper').classList.add('hidden');
    document.getElementById('product_preview_wrapper').classList.remove('flex');
    document.getElementById('product_empty_state').classList.remove('hidden');
    document.getElementById('product_empty_state').classList.add('flex');
}

function handleProductDrop(ev) {
    const file = ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
    if (!file) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    const input = document.getElementById('product_image_input');
    input.files = dt.files;
    previewProductImg(input);
}

function previewProductImg(input) {
    const file = input.files && input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) {
        input.value = '';
        if (window.showCenterPopup) window.showCenterPopup('error', 'File Too Large', 'Maximum product image size is 2MB.');
        return;
    }
    const allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
    if (!allowed.includes(file.type)) {
        input.value = '';
        if (window.showCenterPopup) window.showCenterPopup('error', 'Invalid Format', 'Only JPG, PNG, GIF, and WEBP images are allowed.');
        return;
    }
    document.getElementById('remove_image_flag').value = '0';
    document.getElementById('product_file_name').textContent = file.name;
    const reader = new FileReader();
    reader.onload = function(ev) {
        document.getElementById('product_image_preview').innerHTML =
            `<img src="${ev.target.result}" alt="Preview" class="w-full h-full rounded-xl object-cover">` +
            `<span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full bg-emerald-500 text-white text-[10px] font-bold shadow-xs">Ready</span>`;
        document.getElementById('product_empty_state').classList.add('hidden');
        document.getElementById('product_empty_state').classList.remove('flex');
        document.getElementById('product_preview_wrapper').classList.remove('hidden');
        document.getElementById('product_preview_wrapper').classList.add('flex');
    };
    reader.readAsDataURL(file);
}
</script>
