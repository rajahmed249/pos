@php
    $isEdit = isset($product) && $product?->exists;
    $cur = $appSettings['currency'] ?? '৳';
    $purchasePriceInit = (float) old('purchase_price', $isEdit ? $product->purchase_price : 0);
    $sellingPriceInit = (float) old('selling_price', $isEdit ? $product->selling_price : 0);
    $profitInit = $sellingPriceInit - $purchasePriceInit;
    $marginInit = $sellingPriceInit > 0 ? round(($profitInit / $sellingPriceInit) * 100) : 0;
@endphp

