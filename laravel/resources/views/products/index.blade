                    <tbody>
                        @foreach($products as $idx => $product)
                            @php
                                $qty = (int) ($product->stock_quantity ?? $product->quantity ?? 0);
                                $alert = (int) ($product->alert_quantity ?? 5);
                                $stockClass = $qty <= 0 ? 'bg-[#fee2e2] text-[#dc2626]' : ($qty <= $alert ? 'bg-[#fef3c7] text-[#d97706]' : 'bg-[#d1fae5] text-[#059669]');
                                $dotClass = $qty <= 0 ? 'bg-[#dc2626]' : ($qty <= $alert ? 'bg-[#d97706]' : 'bg-[#059669]');
                                $stockLabel = $qty <= 0 ? 'Out of Stock' : ($qty <= $alert ? 'Low Stock' : 'In Stock');
                            @endphp
                            <tr class="border-b border-[#f1f5f9] hover:bg-[#f8fafc]">
                                <td class="py-3 px-4 text-[#64748b] tabular-nums">{{ $products->firstItem() + $idx }}</td>
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-[#1e293b]">{{ $product->name }}</div>
                                    <div class="text-[11px] text-[#94a3b8]">SKU: {{ $product->sku ?: 'N/A' }}</div>
                                </td>
                                <td class="py-3 px-4"><span class="px-3 py-0.5 rounded-full text-[11px] font-medium bg-[#eef2ff] text-[#4f46e5]">{{ $product->category?->name ?: 'Uncategorized' }}</span></td>
                                <td class="py-3 px-4"><span class="px-3 py-0.5 rounded-full text-[11px] font-medium bg-[#f1f5f9] text-[#475569]">{{ $product->brand?->name ?: 'No Brand' }}</span></td>
                                <td class="py-3 px-4"><span class="px-3 py-0.5 rounded-full text-[11px] font-medium bg-[#eef2ff] text-[#4f46e5]">{{ $product->warranty ?: 'No Warranty' }}</span></td>
                                <td class="py-3 px-4 text-right font-semibold tabular-nums">{{ $cur }}{{ number_format($product->selling_price, 2) }}</td>
                                <td class="py-3 px-4 text-right text-[#64748b] tabular-nums">{{ $cur }}{{ number_format($product->purchase_price, 2) }}</td>
                                <td class="py-3 px-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold {{ $stockClass }}">
                                        <span class="w-1.5 h-1.5 rounded-full {{ $dotClass }}"></span>
                                        {{ $stockLabel }} ({{ number_format($qty) }})
                                    </span>
                                </td>
                            </tr>
                        @endforeach
