<script>
(function () {
    var activeProdMenuId = null;

    window.closeProductActionMenus = function () {
        document.querySelectorAll('.product-floating-menu').forEach(function (el) {
            el.classList.add('hidden');
        });
        activeProdMenuId = null;
    };

    window.openProductActionMenu = function (e, productId) {
        e.stopPropagation();
        var menu = document.getElementById('product-menu-' + productId);
        if (!menu) return;
        if (activeProdMenuId === productId && !menu.classList.contains('hidden')) {
            window.closeProductActionMenus();
            return;
        }
        window.closeProductActionMenus();
        menu.classList.remove('hidden');
        var rect = e.currentTarget.getBoundingClientRect();
        var menuWidth = 192;
        var menuHeight = menu.offsetHeight || 168;
        var left = Math.max(12, Math.min(rect.right - menuWidth, window.innerWidth - menuWidth - 12));
        var spaceBelow = window.innerHeight - rect.bottom;
        var top = spaceBelow >= menuHeight + 8 ? rect.bottom + 6 : Math.max(12, rect.top - menuHeight - 6);
        menu.style.left = left + 'px';
        menu.style.top = top + 'px';
        activeProdMenuId = productId;
    };

    window.openAdjustStockModal = function (productId, name, currentQty) {
        window.closeProductActionMenus();
        document.getElementById('adjustStockForm').action = '{{ url("/products") }}/' + productId + '/adjust';
        document.getElementById('adjustStockName').textContent = name;
        document.getElementById('adjustStockQty').value = currentQty;
        var modal = document.getElementById('adjustStockModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeAdjustStockModal = function () {
        var modal = document.getElementById('adjustStockModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    window.openDeleteProductModal = function (productId, name) {
        window.closeProductActionMenus();
        document.getElementById('deleteProductForm').action = '{{ url("/products") }}/' + productId;
        document.getElementById('deleteProductName').textContent = name;
        var modal = document.getElementById('deleteProductModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeDeleteProductModal = function () {
        var modal = document.getElementById('deleteProductModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    document.addEventListener('click', window.closeProductActionMenus);
    window.addEventListener('scroll', window.closeProductActionMenus, true);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            window.closeProductActionMenus();
            window.closeAdjustStockModal();
            window.closeDeleteProductModal();
        }
    });
})();
</script>
@endsection
