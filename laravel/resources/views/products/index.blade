                    @forelse($products as $idx => $product)
                        @php
                            $qty = (int) ($product->stock_quantity ?? $product->quantity ?? 0);
                            $alert = (int) ($product->alert_quantity ?? 5);
                            $stockClass = $qty <= 0 ? 'bg-[#fee2e2] text-[#dc2626] border border-red-200/70' : ($qty <= $alert ? 'bg-[#fef3c7] text-[#d97706] border border-amber-200/70' : 'bg-[#d1fae5] text-[#059669] border border-emerald-200/70');
                            $dotClass = $qty <= 0 ? 'bg-[#dc2626]' : ($qty <= $alert ? 'bg-[#d97706]' : 'bg-[#059669]');
                            $stockLabel = $qty <= 0 ? 'Out of Stock' : ($qty <= $alert ? 'Low Stock' : 'In Stock');
                            $rawWarranty = trim((string) ($product->warranty ?? ''));
                            if ($rawWarranty === '' || strcasecmp($rawWarranty, 'No Warranty') === 0) {
                                $recDur = trim((string) ($product->warrantyRecord?->duration ?: $product->warrantyRecord?->name ?: ''));
                                if ($recDur !== '' && strcasecmp($recDur, 'No Warranty') !== 0) {
                                    $warrantyLabel = $recDur;
                                } elseif ((int) ($product->warranty_months ?? 0) > 0) {
                                    $months = (int) $product->warranty_months;
                                    $warrantyLabel = $months % 12 === 0 ? ($months / 12) . ' Year' . ($months > 12 ? 's' : '') : $months . ' Months';
                                } else {
                                    $warrantyLabel = 'No Warranty';
                                }
                            } else {
                                $warrantyLabel = $rawWarranty;
                            }
                            $hasWarranty = strcasecmp($warrantyLabel, 'No Warranty') !== 0;
                        @endphp
