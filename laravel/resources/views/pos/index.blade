<script>
const cur = @js($cur);
const posCart = [];
function showPosCartWarning(msg) {
    const el = document.getElementById('posCartWarning');
    if (!msg) { el.classList.add('hidden'); el.textContent = ''; return; }
    el.textContent = msg;
    el.classList.remove('hidden');
}
function addPosItem(id, name, sku, price, warranty, maxStock) {
    const limit = Math.max(0, parseInt(maxStock, 10) || 0);
    if (limit <= 0) {
        const msg = `${name} is out of stock.`;
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Out of Stock', msg);
        return;
    }
    const existing = posCart.find(i => i.product_id === id);
    if (existing) {
        if (existing.quantity >= existing.maxStock) {
            const msg = `Only ${existing.maxStock} unit(s) available for ${existing.name}.`;
            showPosCartWarning(msg);
            if (window.showCenterPopup) window.showCenterPopup('warning', 'Stock Limit Reached', msg);
            return;
        }
        existing.quantity += 1;
    } else {
        posCart.push({ product_id: id, name, sku, price, quantity: 1, maxStock: limit, serial_no: '', warranty: warranty || '' });
    }
    showPosCartWarning('');
    renderPosCart();
}
function clearPosCart() {
    posCart.length = 0;
    showPosCartWarning('');
    renderPosCart();
}
function removePosItem(idx) {
    posCart.splice(idx, 1);
    showPosCartWarning('');
    renderPosCart();
}
function updateCartQty(idx, raw) {
    const item = posCart[idx];
    if (!item) return;
    let q = parseInt(raw, 10) || 1;
    if (q < 1) q = 1;
    if (q > item.maxStock) {
        q = item.maxStock;
        const msg = `Maximum available stock for ${item.name} is ${item.maxStock}.`;
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Stock Limit Reached', msg);
    } else {
        showPosCartWarning('');
    }
    item.quantity = q;
    renderPosCart();
}
function renderPosCart() {
    const body = document.getElementById('posCartBody');
    const badge = document.getElementById('posCartCountBadge');
    const totalUnits = posCart.reduce((s, i) => s + i.quantity, 0);
    if (badge) badge.textContent = `${posCart.length} ${posCart.length === 1 ? 'Item' : 'Items'} • ${totalUnits} Qty`;

    if (!posCart.length) {
        body.innerHTML = '<tr><td colspan="7" class="py-14 px-5 text-center text-slate-400 bg-gradient-to-br from-slate-50/70 via-white to-indigo-50/40"><div class="w-16 h-16 rounded-2xl mx-auto mb-3 flex items-center justify-center text-indigo-600 shadow-xs" style="background: linear-gradient(135deg, rgba(79,70,229,0.12), rgba(124,58,237,0.14));"><i class="fas fa-cart-plus text-2xl"></i></div><div class="text-sm font-bold text-slate-700">Cart is empty</div><small class="text-xs text-slate-500">Search or click &ldquo;Add&rdquo; from the Product List to start billing</small></td></tr>';
        updatePosCartTotals();
        return;
    }
    body.innerHTML = posCart.map((it, idx) => `
        <tr class="hover:bg-indigo-50/25 transition-colors">
            <td class="py-3 px-3"><strong class="text-slate-800">${it.name}</strong><br><small class="text-[10px] text-slate-400">SKU: ${it.sku} &bull; Max: ${it.maxStock}</small></td>
            <td class="py-3 px-2"><input type="text" value="${it.serial_no}" oninput="posCart[${idx}].serial_no=this.value" placeholder="Serial No" class="w-24 px-2.5 py-1.5 border border-slate-200 rounded-lg bg-white"></td>
            <td class="py-3 px-2">${it.warranty ? `<span class="bg-indigo-50 text-indigo-700 border border-indigo-100 px-2.5 py-1 rounded-full text-[11px] font-semibold whitespace-nowrap">${it.warranty}</span>` : '<span class="text-slate-400">—</span>'}</td>
            <td class="py-3 px-2 text-center">
                <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50 overflow-hidden">
                    <button type="button" onclick="updateCartQty(${idx}, ${it.quantity - 1})" class="px-2 py-1 text-slate-600 hover:bg-slate-200/70 cursor-pointer"><i class="fas fa-minus text-[10px]"></i></button>
                    <input type="number" min="1" max="${it.maxStock}" value="${it.quantity}" onchange="updateCartQty(${idx}, this.value)" class="w-11 py-1 bg-white text-center font-bold tabular-nums border-x border-slate-200">
                    <button type="button" onclick="updateCartQty(${idx}, ${it.quantity + 1})" class="px-2 py-1 text-slate-600 hover:bg-slate-200/70 cursor-pointer"><i class="fas fa-plus text-[10px]"></i></button>
                </div>
            </td>
            <td class="py-3 px-2 text-right"><input type="number" step="0.01" min="0" value="${it.price}" oninput="posCart[${idx}].price=Math.max(0,parseFloat(this.value)||0);updatePosCartTotals()" class="w-24 px-2.5 py-1.5 border border-slate-200 rounded-lg text-right font-semibold bg-white tabular-nums"></td>
            <td class="py-3 px-2 text-right font-extrabold text-indigo-700 tabular-nums">${(it.quantity * it.price).toFixed(2)}</td>
            <td class="py-3 px-2.5 text-center"><button type="button" onclick="removePosItem(${idx})" class="bg-red-50 hover:bg-red-600 text-red-600 hover:text-white border border-red-200/70 px-2 py-1.5 rounded-lg transition-colors cursor-pointer"><i class="fas fa-trash-alt"></i></button></td>
        </tr>
    `).join('');
    updatePosCartTotals();
}
function updatePosCartTotals() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    document.getElementById('posSubtotalText').textContent = cur + sub.toFixed(2);
    document.getElementById('posTotalText').textContent = cur + sub.toFixed(2);
    const btnTot = document.getElementById('posBtnTotalText');
    if (btnTot) btnTot.textContent = cur + sub.toFixed(2);
}
function matchesTokens(haystack, rawQuery) {
    const tokens = rawQuery.toLowerCase().trim().split(/\s+/).filter(Boolean);
    if (!tokens.length) return true;
    const text = (haystack || '').toLowerCase();
    return tokens.every(t => text.includes(t));
}
function filterProductRows(term) {
    const q = term.toLowerCase().trim();
    let visible = 0;
    document.querySelectorAll('.pos-product-row').forEach(el => {
        const match = !q || matchesTokens(el.dataset.search, q);
        el.style.display = match ? 'flex' : 'none';
        if (match) visible += 1;
    });
    const badge = document.getElementById('posProductCountBadge');
    if (badge) badge.textContent = visible;
}
function renderTopSearchDropdown(rawQuery) {
    const dropdown = document.getElementById('posTopDropdown');
    const clearBtn = document.getElementById('posTopSearchClear');
    const q = rawQuery.trim().toLowerCase();
    if (clearBtn) clearBtn.classList.toggle('hidden', !q);
    if (!dropdown) return;
    if (!q) {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        return;
    }
    const rows = Array.from(document.querySelectorAll('.pos-product-row')).filter(el => matchesTokens(el.dataset.search, q));
    rows.sort((a, b) => {
        const aExact = (a.dataset.barcode || '').toLowerCase() === q || (a.dataset.sku || '').toLowerCase() === q ? 1 : 0;
        const bExact = (b.dataset.barcode || '').toLowerCase() === q || (b.dataset.sku || '').toLowerCase() === q ? 1 : 0;
        return bExact - aExact;
    });
    if (!rows.length) {
        dropdown.innerHTML = '<div class="p-5 text-center text-sm text-slate-400">No matching products found</div>';
        dropdown.classList.remove('hidden');
        return;
    }
    const shown = rows.slice(0, 60);
    dropdown.innerHTML = shown.map(el => {
        const id = parseInt(el.dataset.id, 10);
        const name = el.dataset.name || '';
        const sku = el.dataset.sku || 'N/A';
        const price = parseFloat(el.dataset.price || '0');
        const stock = parseInt(el.dataset.stock || '0', 10);
        const out = stock <= 0;
        return `<div data-pick-id="${id}" class="pos-top-pick flex items-center justify-between gap-3 px-3.5 py-2.5 ${out ? 'opacity-60 bg-red-50/60 cursor-not-allowed' : 'hover:bg-indigo-50/60 cursor-pointer'}">
            <div class="min-w-0 flex-1">
                <div class="text-[13px] font-bold text-slate-800 truncate">${name.replace(/</g, '&lt;')}</div>
                <div class="text-[11px] text-slate-500 mt-0.5 flex flex-wrap items-center gap-2">
                    <span>SKU: ${sku.replace(/</g, '&lt;')}</span>
                    <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold ${out ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-700'}">${out ? 'Out of Stock' : 'Stock: ' + stock}</span>
                </div>
            </div>
            <div class="flex items-center gap-2.5 shrink-0">
                <span class="text-[13px] font-extrabold text-emerald-600 tabular-nums">${cur}${price.toFixed(2)}</span>
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold text-white ${out ? 'bg-slate-300' : ''}" ${out ? '' : 'style="background:linear-gradient(135deg,#4f46e5,#7c3aed)"'}>Add</span>
            </div>
        </div>`;
    }).join('') + (rows.length > shown.length ? `<div class="px-3.5 py-2 text-center text-[11px] font-semibold text-indigo-600 bg-indigo-50/40">Showing ${shown.length} of ${rows.length} matching products — refine search to narrow</div>` : '');
    dropdown.querySelectorAll('.pos-top-pick').forEach(item => {
        item.addEventListener('click', () => {
            const target = document.querySelector(`.pos-product-row[data-id="${item.dataset.pickId}"]`);
            if (!target) return;
            addPosItem(parseInt(target.dataset.id, 10), target.dataset.name, target.dataset.sku, parseFloat(target.dataset.price), target.dataset.warranty, parseInt(target.dataset.stock, 10));
            clearPosTopSearch();
        });
    });
    dropdown.classList.remove('hidden');
}
function clearPosTopSearch() {
    const inp = document.getElementById('posTopSearch');
    if (inp) inp.value = '';
    renderTopSearchDropdown('');
    filterProductRows(document.getElementById('posSideSearch')?.value || '');
}
function clearPosSideSearch() {
    const inp = document.getElementById('posSideSearch');
    if (inp) inp.value = '';
    const clearBtn = document.getElementById('posSideSearchClear');
    if (clearBtn) clearBtn.classList.add('hidden');
    filterProductRows('');
}
document.getElementById('posSideSearch').addEventListener('input', e => {
    const clearBtn = document.getElementById('posSideSearchClear');
    if (clearBtn) clearBtn.classList.toggle('hidden', !e.target.value.trim());
    filterProductRows(e.target.value);
});
document.getElementById('posTopSearch').addEventListener('input', e => {
    renderTopSearchDropdown(e.target.value);
    filterProductRows(e.target.value);
});
document.getElementById('posTopSearch').addEventListener('keydown', e => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const q = e.target.value.trim().toLowerCase();
    if (!q) return;
    const rows = Array.from(document.querySelectorAll('.pos-product-row')).filter(el => matchesTokens(el.dataset.search, q));
    const exact = rows.find(el => (el.dataset.barcode || '').toLowerCase() === q || (el.dataset.sku || '').toLowerCase() === q) || (rows.length === 1 ? rows[0] : null);
    if (exact) {
        addPosItem(parseInt(exact.dataset.id, 10), exact.dataset.name, exact.dataset.sku, parseFloat(exact.dataset.price), exact.dataset.warranty, parseInt(exact.dataset.stock, 10));
        clearPosTopSearch();
    }
});
document.addEventListener('click', e => {
    const wrap = document.getElementById('posTopSearchWrap');
    const dropdown = document.getElementById('posTopDropdown');
    if (wrap && dropdown && !wrap.contains(e.target)) dropdown.classList.add('hidden');
});

function setModalError(msg) {
    const box = document.getElementById('posModalError');
    if (!msg) {
        box.classList.add('hidden');
        box.textContent = '';
        return;
    }
    box.textContent = msg;
    box.classList.remove('hidden');
}

function openPosPaymentModal() {
    if (!posCart.length) {
        const msg = 'Cart is empty! Please add at least one product before proceeding to payment.';
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Cart Is Empty', msg);
        return;
    }
    const custSel = document.getElementById('posCustomerSelect');
    const isWalkIn = !custSel.value;
    document.getElementById('modalCustomerId').value = custSel.value;
    document.getElementById('modalSaleDate').value = document.getElementById('posDatePicker').value;
    document.getElementById('modalCartHiddenInputs').innerHTML = posCart.map((it, idx) => `
        <input type="hidden" name="items[${idx}][product_id]" value="${it.product_id}">
        <input type="hidden" name="items[${idx}][quantity]" value="${it.quantity}">
        <input type="hidden" name="items[${idx}][price]" value="${it.price}">
        <input type="hidden" name="items[${idx}][serial_no]" value="${it.serial_no}">
        <input type="hidden" name="items[${idx}][warranty]" value="${it.warranty || 'No Warranty'}">
    `).join('');
    document.getElementById('walkInBanner').classList.toggle('hidden', !isWalkIn);
    setModalError('');
    // Keep Received Amount empty until PAID is clicked or user types
    document.getElementById('mPaid').value = '';
    updatePosModalTotals();
    document.getElementById('posPaymentModal').classList.remove('hidden');
    document.getElementById('posPaymentModal').classList.add('flex');
}
function closePosPaymentModal() {
    document.getElementById('posPaymentModal').classList.add('hidden');
    document.getElementById('posPaymentModal').classList.remove('flex');
}
function fillFullPaid() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = parseFloat(document.getElementById('mDiscount').value) || 0;
    const vat = parseFloat(document.getElementById('mVat').value) || 0;
    document.getElementById('mPaid').value = Math.max(0, sub - disc + vat).toFixed(2);
    updatePosModalTotals();
}
function updatePosModalTotals() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = Math.max(0, parseFloat(document.getElementById('mDiscount').value) || 0);
    const vat = Math.max(0, parseFloat(document.getElementById('mVat').value) || 0);
    const net = Math.max(0, sub - disc + vat);
    const rec = Math.max(0, parseFloat(document.getElementById('mPaid').value) || 0);
    const due = Math.max(0, net - rec);
    const custSel = document.getElementById('posCustomerSelect');
    const prevDue = parseFloat(custSel.selectedOptions[0]?.dataset.due || '0') || 0;

    document.getElementById('mItemCount').textContent = posCart.length;
    document.getElementById('mSubtotal').textContent = cur + sub.toFixed(2);
    document.getElementById('mPrevDue').textContent = cur + prevDue.toFixed(2);
    document.getElementById('mTotalAmount').textContent = cur + net.toFixed(2);
    document.getElementById('sSubtotal').textContent = cur + sub.toFixed(2);
    document.getElementById('sDiscount').textContent = cur + disc.toFixed(2);
    document.getElementById('sVat').textContent = cur + vat.toFixed(2);
    document.getElementById('sNet').textContent = cur + net.toFixed(2);
    document.getElementById('sReceived').textContent = cur + rec.toFixed(2);
    document.getElementById('sDue').textContent = cur + due.toFixed(2);

    if (disc > sub + 0.009) {
        setModalError('Discount cannot exceed subtotal.');
    } else {
        setModalError('');
    }
}

document.getElementById('posCheckoutForm').addEventListener('submit', function(e) {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = parseFloat(document.getElementById('mDiscount').value) || 0;
    const vat = parseFloat(document.getElementById('mVat').value) || 0;
    const net = Math.max(0, sub - disc + vat);
    const rawPaid = document.getElementById('mPaid').value;
    const rec = rawPaid === '' ? 0 : (parseFloat(rawPaid) || 0);
    const due = Math.max(0, net - rec);
    const isWalkIn = !document.getElementById('modalCustomerId').value;

    if (disc < 0 || vat < 0 || rec < 0) {
        e.preventDefault();
        const msg = 'Discount, VAT, and Received Amount cannot be negative.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Invalid Amount', msg);
        return;
    }
    if (disc > sub + 0.009) {
        e.preventDefault();
        const msg = 'Discount cannot exceed subtotal.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Invalid Discount', msg);
        return;
    }
    if (isWalkIn && due > 0.009) {
        e.preventDefault();
        const msg = 'Walk-in Customer cannot have due balance! Please collect full payment or select a registered customer.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Full Payment Required', msg);
        return;
    }
    if (rawPaid === '') {
        document.getElementById('mPaid').value = '0';
    }
});
</script>
@endsection
