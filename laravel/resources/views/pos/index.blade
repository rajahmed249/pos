<script>
const cur = @js($cur);
const posCart = [];
function showPosCartWarning(msg) {
    const el = document.getElementById('posCartWarning');
    if (!msg) { el.classList.add('hidden'); el.textContent = ''; return; }
    el.textContent = msg;
    el.classList.remove('hidden');
}
function addPosItem(id, name, sku, price, warranty, maxStock) {
    const limit = Math.max(0, parseInt(maxStock, 10) || 0);
    if (limit <= 0) {
        const msg = `${name} is out of stock.`;
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Out of Stock', msg);
        return;
    }
    const existing = posCart.find(i => i.product_id === id);
    if (existing) {
        if (existing.quantity >= existing.maxStock) {
            const msg = `Only ${existing.maxStock} unit(s) available for ${existing.name}.`;
            showPosCartWarning(msg);
            if (window.showCenterPopup) window.showCenterPopup('warning', 'Stock Limit Reached', msg);
            return;
        }
        existing.quantity += 1;
    } else {
        posCart.push({ product_id: id, name, sku, price, quantity: 1, maxStock: limit, serial_no: '', warranty: warranty || '' });
    }
    showPosCartWarning('');
    renderPosCart();
}
function clearPosCart() {
    posCart.length = 0;
    showPosCartWarning('');
    renderPosCart();
}
function removePosItem(idx) {
    posCart.splice(idx, 1);
    showPosCartWarning('');
    renderPosCart();
}
function updateCartQty(idx, raw) {
    const item = posCart[idx];
    if (!item) return;
    let q = parseInt(raw, 10) || 1;
    if (q < 1) q = 1;
    if (q > item.maxStock) {
        q = item.maxStock;
        const msg = `Maximum available stock for ${item.name} is ${item.maxStock}.`;
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Stock Limit Reached', msg);
    } else {
        showPosCartWarning('');
    }
    item.quantity = q;
    renderPosCart();
}
function renderPosCart() {
    const body = document.getElementById('posCartBody');
    if (!posCart.length) {
        body.innerHTML = '<tr><td colspan="7" class="py-12 text-center text-slate-400"><i class="fas fa-cart-plus text-4xl text-slate-300 block mb-2"></i><div class="font-semibold text-slate-600">Cart is empty</div><small>Search and add products to continue</small></td></tr>';
        updatePosCartTotals();
        return;
    }
    body.innerHTML = posCart.map((it, idx) => `
        <tr class="border-b border-[#eef2f6]">
            <td class="py-2.5 px-2.5"><strong class="text-slate-800">${it.name}</strong><br><small class="text-slate-400">SKU: ${it.sku} · Stock: ${it.maxStock}</small></td>
            <td class="py-2.5 px-2"><input type="text" value="${it.serial_no}" oninput="posCart[${idx}].serial_no=this.value" placeholder="Serial No" class="w-24 px-2 py-1 border border-[#e2e8f0] rounded"></td>
            <td class="py-2.5 px-2">${it.warranty ? `<span class="bg-[#eef2ff] text-[#667eea] px-2.5 py-0.5 rounded-full text-[11px] whitespace-nowrap">${it.warranty}</span>` : '<span class="text-slate-400">—</span>'}</td>
            <td class="py-2.5 px-2 text-center"><input type="number" min="1" max="${it.maxStock}" value="${it.quantity}" onchange="updateCartQty(${idx}, this.value)" class="w-16 px-2 py-1 border border-[#e2e8f0] rounded text-center tabular-nums"></td>
            <td class="py-2.5 px-2 text-right"><input type="number" step="0.01" min="0" value="${it.price}" oninput="posCart[${idx}].price=Math.max(0,parseFloat(this.value)||0);updatePosCartTotals()" class="w-24 px-2 py-1 border border-[#e2e8f0] rounded text-right tabular-nums"></td>
            <td class="py-2.5 px-2 text-right font-semibold tabular-nums">${(it.quantity * it.price).toFixed(2)}</td>
            <td class="py-2.5 px-2 text-center"><button type="button" onclick="removePosItem(${idx})" class="bg-[#ef4444] text-white px-2 py-1 rounded"><i class="fas fa-trash-alt"></i></button></td>
        </tr>
    `).join('');
    updatePosCartTotals();
}
function updatePosCartTotals() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    document.getElementById('posSubtotalText').textContent = cur + sub.toFixed(2);
    document.getElementById('posTotalText').textContent = cur + sub.toFixed(2);
}
function filterProductRows(term) {
    const q = term.toLowerCase().trim();
    document.querySelectorAll('.pos-product-row').forEach(el => {
        el.style.display = !q || el.dataset.search.includes(q) ? 'flex' : 'none';
    });
}
document.getElementById('posSideSearch').addEventListener('input', e => filterProductRows(e.target.value));
document.getElementById('posTopSearch').addEventListener('input', e => filterProductRows(e.target.value));

function setModalError(msg) {
    const box = document.getElementById('posModalError');
    if (!msg) {
        box.classList.add('hidden');
        box.textContent = '';
        return;
    }
    box.textContent = msg;
    box.classList.remove('hidden');
}

function openPosPaymentModal() {
    if (!posCart.length) {
        const msg = 'Cart is empty! Please add at least one product before proceeding to payment.';
        showPosCartWarning(msg);
        if (window.showCenterPopup) window.showCenterPopup('warning', 'Cart Is Empty', msg);
        return;
    }
    const custSel = document.getElementById('posCustomerSelect');
    const isWalkIn = !custSel.value;
    document.getElementById('modalCustomerId').value = custSel.value;
    document.getElementById('modalSaleDate').value = document.getElementById('posDatePicker').value;
    document.getElementById('modalCartHiddenInputs').innerHTML = posCart.map((it, idx) => `
        <input type="hidden" name="items[${idx}][product_id]" value="${it.product_id}">
        <input type="hidden" name="items[${idx}][quantity]" value="${it.quantity}">
        <input type="hidden" name="items[${idx}][price]" value="${it.price}">
        <input type="hidden" name="items[${idx}][serial_no]" value="${it.serial_no}">
        <input type="hidden" name="items[${idx}][warranty]" value="${it.warranty || 'No Warranty'}">
    `).join('');
    document.getElementById('walkInBanner').classList.toggle('hidden', !isWalkIn);
    setModalError('');
    // Keep Received Amount empty until PAID is clicked or user types
    document.getElementById('mPaid').value = '';
    updatePosModalTotals();
    document.getElementById('posPaymentModal').classList.remove('hidden');
    document.getElementById('posPaymentModal').classList.add('flex');
}
function closePosPaymentModal() {
    document.getElementById('posPaymentModal').classList.add('hidden');
    document.getElementById('posPaymentModal').classList.remove('flex');
}
function fillFullPaid() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = parseFloat(document.getElementById('mDiscount').value) || 0;
    const vat = parseFloat(document.getElementById('mVat').value) || 0;
    document.getElementById('mPaid').value = Math.max(0, sub - disc + vat).toFixed(2);
    updatePosModalTotals();
}
function updatePosModalTotals() {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = Math.max(0, parseFloat(document.getElementById('mDiscount').value) || 0);
    const vat = Math.max(0, parseFloat(document.getElementById('mVat').value) || 0);
    const net = Math.max(0, sub - disc + vat);
    const rec = Math.max(0, parseFloat(document.getElementById('mPaid').value) || 0);
    const due = Math.max(0, net - rec);
    const custSel = document.getElementById('posCustomerSelect');
    const prevDue = parseFloat(custSel.selectedOptions[0]?.dataset.due || '0') || 0;

    document.getElementById('mItemCount').textContent = posCart.length;
    document.getElementById('mSubtotal').textContent = cur + sub.toFixed(2);
    document.getElementById('mPrevDue').textContent = cur + prevDue.toFixed(2);
    document.getElementById('mTotalAmount').textContent = cur + net.toFixed(2);
    document.getElementById('sSubtotal').textContent = cur + sub.toFixed(2);
    document.getElementById('sDiscount').textContent = cur + disc.toFixed(2);
    document.getElementById('sVat').textContent = cur + vat.toFixed(2);
    document.getElementById('sNet').textContent = cur + net.toFixed(2);
    document.getElementById('sReceived').textContent = cur + rec.toFixed(2);
    document.getElementById('sDue').textContent = cur + due.toFixed(2);

    if (disc > sub + 0.009) {
        setModalError('Discount cannot exceed subtotal.');
    } else {
        setModalError('');
    }
}

document.getElementById('posCheckoutForm').addEventListener('submit', function(e) {
    const sub = posCart.reduce((s, i) => s + (i.quantity * i.price), 0);
    const disc = parseFloat(document.getElementById('mDiscount').value) || 0;
    const vat = parseFloat(document.getElementById('mVat').value) || 0;
    const net = Math.max(0, sub - disc + vat);
    const rawPaid = document.getElementById('mPaid').value;
    const rec = rawPaid === '' ? 0 : (parseFloat(rawPaid) || 0);
    const due = Math.max(0, net - rec);
    const isWalkIn = !document.getElementById('modalCustomerId').value;

    if (rawPaid === '') {
        document.getElementById('mPaid').value = '0';
    }
    if (disc < 0 || vat < 0 || rec < 0) {
        e.preventDefault();
        const msg = 'Discount, VAT, and Received Amount cannot be negative.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Invalid Amount', msg);
        return;
    }
    if (disc > sub + 0.009) {
        e.preventDefault();
        const msg = 'Discount cannot exceed subtotal.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Invalid Discount', msg);
        return;
    }
    if (isWalkIn && due > 0.009) {
        e.preventDefault();
        const msg = 'Walk-in Customer cannot have due balance! Please collect full payment or select a registered customer.';
        setModalError(msg);
        if (window.showCenterPopup) window.showCenterPopup('error', 'Full Payment Required', msg);
        return;
    }
});
</script>
@endsection
