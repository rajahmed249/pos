        .login-ring-cw { animation: loginRingCW 10s linear infinite; }
        .login-ring-ccw { animation: loginRingCCW 14s linear infinite; }
        .login-beam { animation: loginBeamStreak 4.2s linear infinite; }
        .login-particle { animation: loginParticleRise 3.8s linear infinite; }
    </style>
</head>
