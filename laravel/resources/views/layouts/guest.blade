    @php
        $viteManifestPath = public_path('build/manifest.json');
        $viteManifest = file_exists($viteManifestPath) ? json_decode((string) file_get_contents($viteManifestPath), true) : null;
        $cssFile = is_array($viteManifest) ? ($viteManifest['resources/css/app.css']['file'] ?? null) : null;
    @endphp
    @if($cssFile)
        <link rel="stylesheet" href="{{ asset('build/' . ltrim($cssFile, '/')) }}">
