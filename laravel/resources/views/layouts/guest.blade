        @keyframes loginBeamStreak { 0% { transform: translate3d(-120%, -60%, 0) rotate(-28deg); opacity: 0; } 15% { opacity: 0.85; } 85% { opacity: 0.85; } 100% { transform: translate3d(220%, 120%, 0) rotate(-28deg); opacity: 0; } }
        @keyframes loginParticleRise { 0% { transform: translateY(40px) scale(0.6); opacity: 0; } 20% { opacity: 0.9; } 80% { opacity: 0.75; } 100% { transform: translateY(-160px) scale(1.15); opacity: 0; } }
        .login-bg-shift { background-size: 260% 260%; animation: loginBgShift 7s ease infinite; }
