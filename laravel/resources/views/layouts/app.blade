        :root {
            --sidebar-width: 260px;
        }
        .tech-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 50;
            overflow-y: auto;
            overflow-x: hidden;
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.3);
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            transform: translateX(0);
        }
        .tech-sidebar::-webkit-scrollbar { width: 4px; }
        .tech-sidebar::-webkit-scrollbar-thumb { background: #ffd166; border-radius: 10px; }
        .tech-sidebar-header {
            position: sticky;
            top: 0;
            background: #14172b;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 20;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .main-workspace {
            margin-left: var(--sidebar-width);
            min-width: 0;
            transition: margin-left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body.desktop-sidebar-closed .tech-sidebar {
            transform: translateX(-100%);
        }
        body.desktop-sidebar-closed .main-workspace {
            margin-left: 0;
        }
        html, body { overflow-x: clip; }
        .fas, .far, .fab, i[class^="fa-"], i[class*=" fa-"] { flex-shrink: 0; }
        @media (max-width: 1023px) {
            .tech-sidebar { transform: translateX(-100%); width: 260px; }
            .tech-sidebar.show { transform: translateX(0); }
            .main-workspace, body.desktop-sidebar-closed .main-workspace { margin-left: 0 !important; }
        }
    </style>
</head>
