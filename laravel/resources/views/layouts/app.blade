        {{-- Collapsible Dropdown Sections (Auto-expand active group, toggle on click) --}}
        <div class="space-y-1 pt-1 w-full">
            @foreach($dropdownGroups as $group => $items)
                @php
                    $groupId = 'grp-' . \Illuminate\Support\Str::slug($group);
                    $isMenuActive = function ($m) {
                        $targetUrl = $m->resolvedUrl();
                        return request()->url() === $targetUrl
                            || ($m->route_name && request()->routeIs($m->route_name))
                            || ($m->route_name === 'products.index' && request()->routeIs('products.edit'))
                            || ($m->route_name === 'units.index' && request()->routeIs('warranties.*'));
                    };
                    $hasActiveChild = $items->contains($isMenuActive);
                @endphp
                <div class="w-full">
                    <button type="button"
                            onclick="toggleMenuGroup('{{ $groupId }}')"
                            class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-[10px] text-[13px] font-medium transition-all cursor-pointer {{ $hasActiveChild ? 'bg-white/10 text-white' : 'text-white/85 hover:bg-[#ffd166]/10 hover:text-white' }}">
                        @include('components.menu-icon', [
                            'group' => $group,
                            'size' => 17,
                            'class' => 'text-[#ffd166]',
                        ])
                        <span class="truncate flex-1 text-left">{{ $group }}</span>
                        <svg id="{{ $groupId }}-arrow" width="15" height="15" style="width:15px;height:15px;flex-shrink:0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 {{ $hasActiveChild ? 'rotate-90 text-[#ffd166]' : 'text-white/50' }}" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                    <ul id="{{ $groupId }}-list" class="{{ $hasActiveChild ? '' : 'hidden' }} list-none m-0 px-0 w-full mt-1 rounded-xl bg-black/25 py-1 space-y-0.5">
                        @foreach($items as $menu)
                            @php
                                $targetUrl = $menu->resolvedUrl();
                                $isActive = $isMenuActive($menu);
                            @endphp
                            <li class="w-full">
                                <a href="{{ $targetUrl }}"
