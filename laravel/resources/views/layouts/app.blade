{{-- Global High-Priority Centered Notification Pop-up (Stacks cleanly above any modal) --}}
<div id="centerPopupModal" onclick="closeCenterPopup()" class="no-print fixed inset-0 z-[120] bg-slate-950/60 hidden items-center justify-center p-4">
    <div onclick="event.stopPropagation()" class="relative w-full max-w-md bg-white rounded-[22px] border border-slate-200 shadow-[0_30px_80px_rgba(15,23,42,0.35)] overflow-hidden">
        <div id="centerPopupAccent" class="h-1.5 bg-red-600"></div>
        <button type="button" onclick="closeCenterPopup()" aria-label="Close notification" class="absolute top-3.5 right-3.5 w-8 h-8 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100 flex items-center justify-center cursor-pointer">
            <i class="fas fa-times text-xs"></i>
        </button>
        <div class="p-6 pt-7 text-center">
            <div id="centerPopupIconBox" class="w-14 h-14 mx-auto rounded-2xl bg-red-50 text-red-600 ring-8 ring-red-50/70 flex items-center justify-center mb-4">
                <i id="centerPopupIcon" class="fas fa-exclamation-triangle text-2xl"></i>
            </div>
            <h3 id="centerPopupTitle" class="font-display text-lg font-bold text-slate-900">Notice</h3>
            <p id="centerPopupMessage" class="mt-2 text-sm text-slate-600 leading-relaxed"></p>
            <div class="mt-6">
                <button type="button" id="centerPopupBtn" onclick="closeCenterPopup()" class="w-full py-2.5 px-5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-semibold shadow-sm cursor-pointer">
                    OK, Got It
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var sidebar = document.getElementById('techSidebar');
    var overlay = document.getElementById('sidebarOverlay');
    window.toggleSidebar = function() {
        if (window.innerWidth < 1024) {
            sidebar.classList.toggle('show');
            overlay.classList.toggle('hidden');
        } else {
            document.body.classList.toggle('desktop-sidebar-closed');
        }
    };
    window.closeSidebar = function() {
        sidebar.classList.remove('show');
        overlay.classList.add('hidden');
    };
    window.toggleMenuGroup = function(groupId) {
        var list = document.getElementById(groupId + '-list');
        var arrow = document.getElementById(groupId + '-arrow');
        if (!list) return;
        list.classList.toggle('hidden');
        if (arrow) {
            arrow.classList.toggle('rotate-90', !list.classList.contains('hidden'));
        }
    };
    window.toggleUserDropdown = function(e) {
        if (e) e.stopPropagation();
        var menu = document.getElementById('userDropdownMenu');
        if (menu) menu.classList.toggle('hidden');
    };
    document.addEventListener('click', function(e) {
        var wrapper = document.getElementById('userDropdownWrapper');
        var menu = document.getElementById('userDropdownMenu');
        if (wrapper && menu && !wrapper.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

    var centerPopupTimer = null;
    window.closeCenterPopup = function() {
        if (centerPopupTimer) {
            clearTimeout(centerPopupTimer);
            centerPopupTimer = null;
        }
        var m = document.getElementById('centerPopupModal');
        if (m) {
            m.classList.add('hidden');
            m.classList.remove('flex');
        }
    };
    window.showCenterPopup = function(type, title, message, confirmLabel) {
        var m = document.getElementById('centerPopupModal');
        if (!m) return;
        if (centerPopupTimer) {
            clearTimeout(centerPopupTimer);
            centerPopupTimer = null;
        }
        var accent = document.getElementById('centerPopupAccent');
        var iconBox = document.getElementById('centerPopupIconBox');
        var icon = document.getElementById('centerPopupIcon');
        var btn = document.getElementById('centerPopupBtn');
        var themes = {
            error: { accent: 'h-1.5 bg-red-600', box: 'w-14 h-14 mx-auto rounded-2xl bg-red-50 text-red-600 ring-8 ring-red-50/70 flex items-center justify-center mb-4', icon: 'fas fa-times-circle text-2xl', btn: 'w-full py-2.5 px-5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-semibold shadow-sm cursor-pointer' },
            warning: { accent: 'h-1.5 bg-amber-500', box: 'w-14 h-14 mx-auto rounded-2xl bg-amber-50 text-amber-600 ring-8 ring-amber-50/70 flex items-center justify-center mb-4', icon: 'fas fa-exclamation-triangle text-2xl', btn: 'w-full py-2.5 px-5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold shadow-sm cursor-pointer' },
            success: { accent: 'h-1.5 bg-emerald-600', box: 'w-14 h-14 mx-auto rounded-2xl bg-emerald-50 text-emerald-600 ring-8 ring-emerald-50/70 flex items-center justify-center mb-4', icon: 'fas fa-check-circle text-2xl', btn: 'w-full py-2.5 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm cursor-pointer' },
            info: { accent: 'h-1.5 bg-indigo-600', box: 'w-14 h-14 mx-auto rounded-2xl bg-indigo-50 text-indigo-600 ring-8 ring-indigo-50/70 flex items-center justify-center mb-4', icon: 'fas fa-info-circle text-2xl', btn: 'w-full py-2.5 px-5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm cursor-pointer' }
        };
        var t = themes[type] || themes.info;
        accent.className = t.accent;
        iconBox.className = t.box;
        icon.className = t.icon;
        btn.className = t.btn;
        btn.textContent = confirmLabel || 'OK, Got It';
        document.getElementById('centerPopupTitle').textContent = title || 'Notification';
        document.getElementById('centerPopupMessage').textContent = message || '';
        m.classList.remove('hidden');
        m.classList.add('flex');
        if (type === 'success' || type === 'info') {
            centerPopupTimer = setTimeout(function() {
                window.closeCenterPopup();
            }, 3200);
        }
    };
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') window.closeCenterPopup();
    });
    document.addEventListener('DOMContentLoaded', function() {
        var flashBanner = document.getElementById('flashSuccessBanner');
        if (flashBanner) {
            setTimeout(function() {
                flashBanner.style.opacity = '0';
                setTimeout(function() {
                    if (flashBanner && flashBanner.parentNode) flashBanner.parentNode.removeChild(flashBanner);
                }, 320);
            }, 3200);
        }
    });
    @if(session('success'))
        document.addEventListener('DOMContentLoaded', function() {
            window.showCenterPopup('success', 'Success', {!! json_encode((string) session('success'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) !!});
        });
    @elseif(isset($errors) && $errors->any())
        document.addEventListener('DOMContentLoaded', function() {
            window.showCenterPopup('error', 'Action Required', {!! json_encode((string) $errors->first(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) !!});
        });
    @endif
    // 1-Hour Continuous Inactivity Auto-Logout (3,600,000 ms)
    var idleLimitMs = 60 * 60 * 1000;
    var lastActivityMs = Date.now();
    var lastIdleThrottle = 0;
    function touchIdleActivity() {
        var now = Date.now();
        if (now - lastIdleThrottle < 1000) return;
        lastIdleThrottle = now;
        lastActivityMs = now;
    }
    function checkIdleLogout() {
        if (Date.now() - lastActivityMs >= idleLimitMs) {
            var form = document.getElementById('idleLogoutForm');
            if (form) form.submit();
        }
    }
    ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'pointerdown'].forEach(function(ev) {
        window.addEventListener(ev, touchIdleActivity, { passive: true });
    });
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') checkIdleLogout();
    });
    setInterval(checkIdleLogout, 15000);
})();
</script>
</body>
</html>
