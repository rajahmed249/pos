            <h3 class="font-display text-base font-bold text-slate-900">Edit Owner Details</h3>
            <button type="button" onclick="closeOwnerEditModal()" class="text-slate-400 hover:text-slate-700 p-1 cursor-pointer text-lg leading-none">&times;</button>
        </div>
        <form id="ownerEditForm" method="POST" action="" class="p-5 space-y-3.5 text-sm">
