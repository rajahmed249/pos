{{-- Owner Transaction History Modal --}}
<div id="ownerHistoryModal" onclick="closeOwnerHistoryModal()" class="fixed inset-0 z-[120] bg-slate-950/55 backdrop-blur-xs hidden items-center justify-center p-4">
    <div onclick="event.stopPropagation()" class="w-full max-w-2xl max-h-[88vh] flex flex-col bg-white rounded-2xl border border-slate-200 shadow-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
            <div>
                <h3 class="font-display text-base font-bold text-slate-900">Owner Transaction History</h3>
                <p id="ownerHistorySubtitle" class="text-xs text-slate-500 mt-0.5"></p>
            </div>
            <button type="button" onclick="closeOwnerHistoryModal()" class="text-slate-400 hover:text-slate-700 p-1 cursor-pointer text-lg leading-none">&times;</button>
        </div>

        <div class="grid grid-cols-3 gap-2.5 p-4 bg-slate-50/50 border-b border-slate-100 text-xs">
            <div class="rounded-xl bg-emerald-50 border border-emerald-200/70 px-3 py-2">
                <div class="text-[10px] font-semibold uppercase text-emerald-700">Total Invested</div>
                <div id="historyTotalInvested" class="font-mono font-bold text-emerald-800 tabular-nums mt-0.5"></div>
            </div>
            <div class="rounded-xl bg-rose-50 border border-rose-200/70 px-3 py-2">
                <div class="text-[10px] font-semibold uppercase text-rose-700">Total Withdrawn</div>
                <div id="historyTotalWithdrawn" class="font-mono font-bold text-rose-800 tabular-nums mt-0.5"></div>
            </div>
            <div class="rounded-xl bg-indigo-50 border border-indigo-200/70 px-3 py-2">
                <div class="text-[10px] font-semibold uppercase text-indigo-700">Net Balance</div>
                <div id="historyNetBalance" class="font-mono font-bold text-indigo-800 tabular-nums mt-0.5"></div>
            </div>
        </div>

        <div class="overflow-y-auto flex-1">
            <table class="w-full text-xs text-left">
                <thead class="bg-slate-50 text-[10.5px] uppercase tracking-wider text-slate-500 border-b border-slate-200 sticky top-0">
                    <tr>
                        <th class="px-4 py-2.5 font-semibold">Date</th>
                        <th class="px-4 py-2.5 font-semibold">Type</th>
                        <th class="px-4 py-2.5 font-semibold">Note</th>
                        <th class="px-4 py-2.5 font-semibold text-right">Amount</th>
                    </tr>
                </thead>
                <tbody id="ownerHistoryTbody" class="divide-y divide-slate-100"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    var curSymbol = @json($cur);
    var activeOwnerData = null;
    var activeOwnerId = null;
    var dropdown = document.getElementById('ownerFloatingDropdown');

    window.switchOwnerTab = function(tab) {
        var listPanel = document.getElementById('ownerTabPanelList');
        var addPanel = document.getElementById('ownerTabPanelAdd');
        var listBtn = document.getElementById('ownerTabBtnList');
        var addBtn = document.getElementById('ownerTabBtnAdd');
        if (!listPanel || !addPanel) return;

        if (tab === 'add') {
            listPanel.classList.add('hidden');
            addPanel.classList.remove('hidden');
            addBtn.style.background = 'linear-gradient(135deg, #4f46e5, #7c3aed)';
            addBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition cursor-pointer';
            listBtn.style.background = '';
            listBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-50 transition cursor-pointer';
        } else {
            addPanel.classList.add('hidden');
            listPanel.classList.remove('hidden');
            listBtn.style.background = 'linear-gradient(135deg, #4f46e5, #7c3aed)';
            listBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition cursor-pointer';
            addBtn.style.background = '';
            addBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-50 transition cursor-pointer';
        }
    };

    window.closeOwnerActionMenu = function() {
        if (dropdown) dropdown.classList.add('hidden');
        activeOwnerId = null;
    };

    window.openOwnerActionMenu = function(e, ownerId) {
        e.stopPropagation();
        var dataEl = document.getElementById('owner-menu-data-' + ownerId);
        if (!dataEl || !dropdown) return;

        if (!dropdown.classList.contains('hidden') && activeOwnerId === ownerId) {
            window.closeOwnerActionMenu();
            return;
        }

        activeOwnerId = ownerId;
        activeOwnerData = dataEl.dataset;

        document.getElementById('ownerToggleForm').action = activeOwnerData.toggleUrl;
        document.getElementById('ownerToggleBtnLabel').querySelector('span:last-child').textContent =
            activeOwnerData.active === '1' ? 'Set Inactive' : 'Set Active';
        document.getElementById('ownerDeleteForm').action = activeOwnerData.deleteUrl;

        dropdown.classList.remove('hidden');
        var rect = e.currentTarget.getBoundingClientRect();
        var menuWidth = 192;
        var left = Math.min(window.innerWidth - menuWidth - 12, Math.max(12, rect.right - menuWidth));
        var menuHeight = dropdown.offsetHeight || 225;
        var top = rect.bottom + 6;
        if (top + menuHeight > window.innerHeight - 12) {
            top = Math.max(12, rect.top - menuHeight - 6);
        }
        dropdown.style.left = left + 'px';
        dropdown.style.top = top + 'px';
    };

    window.triggerOwnerTx = function(type) {
        if (!activeOwnerData) return;
        var data = activeOwnerData;
        window.closeOwnerActionMenu();

        var modal = document.getElementById('ownerTxModal');
        document.getElementById('ownerTxForm').action = data.txUrl;
        document.getElementById('ownerTxType').value = type;
        document.getElementById('ownerTxOwnerName').textContent = data.name;
        document.getElementById('ownerTxAmount').value = '';
        document.getElementById('ownerTxNote').value = '';

        var btn = document.getElementById('ownerTxSubmitBtn');
        if (type === 'invest') {
            document.getElementById('ownerTxTitle').textContent = 'Add Owner Investment (+)';
            btn.className = 'px-5 py-2 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 cursor-pointer';
            btn.textContent = 'Record Investment';
        } else {
            document.getElementById('ownerTxTitle').textContent = 'Record Owner Withdrawal (-)';
            btn.className = 'px-5 py-2 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 cursor-pointer';
            btn.textContent = 'Record Withdrawal';
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(function() { document.getElementById('ownerTxAmount').focus(); }, 40);
    };

    window.closeOwnerTxModal = function() {
        var modal = document.getElementById('ownerTxModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.triggerOwnerEdit = function() {
        if (!activeOwnerData) return;
        var data = activeOwnerData;
        window.closeOwnerActionMenu();

        document.getElementById('ownerEditForm').action = data.updateUrl;
        document.getElementById('editOwnerName').value = data.name || '';
        document.getElementById('editOwnerPhone').value = data.phone || '';
        document.getElementById('editOwnerEmail').value = data.email || '';
        document.getElementById('editOwnerAddress').value = data.address || '';
        document.getElementById('editOwnerShare').value = data.share || '0';
        document.getElementById('editOwnerInvested').value = data.invested || '0';
        document.getElementById('editOwnerWithdrawn').value = data.withdrawn || '0';

        var modal = document.getElementById('ownerEditModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeOwnerEditModal = function() {
        var modal = document.getElementById('ownerEditModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    window.triggerOwnerHistory = function() {
        if (!activeOwnerData) return;
        var data = activeOwnerData;
        var ownerId = data.id;
        window.closeOwnerActionMenu();

        document.getElementById('ownerHistorySubtitle').textContent = data.name || '';
        document.getElementById('historyTotalInvested').textContent = curSymbol + Number(data.invested || 0).toFixed(2);
        document.getElementById('historyTotalWithdrawn').textContent = curSymbol + Number(data.withdrawn || 0).toFixed(2);
        document.getElementById('historyNetBalance').textContent = curSymbol + Number(data.balance || 0).toFixed(2);

        var tbody = document.getElementById('ownerHistoryTbody');
        tbody.innerHTML = '';

        var txRows = [];
        try {
            var jsonEl = document.getElementById('owner-history-json-' + ownerId);
            if (jsonEl && jsonEl.textContent) {
                txRows = JSON.parse(jsonEl.textContent) || [];
            }
        } catch (err) {}

        function renderRows(rows) {
            tbody.innerHTML = '';
            if (!rows || rows.length === 0) {
                var emptyTr = document.createElement('tr');
                var emptyTd = document.createElement('td');
                emptyTd.colSpan = 4;
                emptyTd.className = 'px-4 py-8 text-center text-slate-500';
                emptyTd.textContent = 'No deposit or withdrawal transactions recorded yet.';
                emptyTr.appendChild(emptyTd);
                tbody.appendChild(emptyTr);
                return;
            }
            rows.forEach(function(tx) {
                var tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50';

                var tdDate = document.createElement('td');
                tdDate.className = 'px-4 py-2.5 font-mono text-slate-600 whitespace-nowrap';
                tdDate.textContent = tx.transaction_date || '—';

                var tdType = document.createElement('td');
                tdType.className = 'px-4 py-2.5 whitespace-nowrap';
                var badge = document.createElement('span');
                var isInvest = tx.type === 'invest';
                badge.className = 'px-2 py-0.5 rounded-full text-[10.5px] font-semibold ' +
                    (isInvest ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700');
                badge.textContent = isInvest ? 'Deposit (+)' : 'Withdraw (-)';
                tdType.appendChild(badge);

                var tdNote = document.createElement('td');
                tdNote.className = 'px-4 py-2.5 text-slate-600';
                tdNote.textContent = tx.note || '—';

                var tdAmt = document.createElement('td');
                tdAmt.className = 'px-4 py-2.5 text-right font-mono font-bold tabular-nums whitespace-nowrap ' +
                    (isInvest ? 'text-emerald-700' : 'text-rose-600');
                tdAmt.textContent = (isInvest ? '+' : '-') + curSymbol + Number(tx.amount || 0).toFixed(2);

                tr.appendChild(tdDate);
                tr.appendChild(tdType);
                tr.appendChild(tdNote);
                tr.appendChild(tdAmt);
                tbody.appendChild(tr);
            });
        }

        renderRows(txRows);

        var modal = document.getElementById('ownerHistoryModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');

        if (data.historyUrl && window.fetch) {
            fetch(data.historyUrl, { headers: { 'Accept': 'application/json' } })
                .then(function(r) { return r.ok ? r.json() : null; })
                .then(function(payload) {
                    if (payload && Array.isArray(payload.transactions)) {
                        renderRows(payload.transactions);
                    }
                })
                .catch(function() {});
        }
    };

    window.closeOwnerHistoryModal = function() {
        var modal = document.getElementById('ownerHistoryModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };

    document.addEventListener('click', function(e) {
        if (dropdown && !dropdown.contains(e.target)) {
            window.closeOwnerActionMenu();
        }
    });
    document.addEventListener('scroll', window.closeOwnerActionMenu, true);
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeOwnerActionMenu();
            window.closeOwnerTxModal();
            window.closeOwnerEditModal();
            window.closeOwnerHistoryModal();
        }
    });
})();
</script>
@endsection
