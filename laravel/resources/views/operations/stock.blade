@php
    $cur = $appSettings['currency'] ?? '৳';
    $totalSkus = $products->count();
    $totalUnits = (int) $products->sum(fn ($p) => max(0, (int) ($p->stock_quantity ?? $p->quantity ?? 0)));
    $totalStockCost = (float) $products->sum(fn ($p) => max(0, (int) ($p->stock_quantity ?? $p->quantity ?? 0)) * (float) $p->purchase_price);
    $lowOrOutCount = (int) $products->filter(fn ($p) => (int) ($p->stock_quantity ?? $p->quantity ?? 0) <= (int) ($p->alert_quantity ?? 5))->count();
@endphp

