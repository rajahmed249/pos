        <tbody class="divide-y divide-slate-100">
            @forelse($movements as $m)
                <tr>
                    <td class="py-2 pr-3 font-medium text-slate-800">{{ $m->product?->name ?? 'Product #' . $m->product_id }}</td>
                    <td class="py-2 pr-3 tabular-nums">{{ $m->old_quantity }}</td>
                    <td class="py-2 pr-3 tabular-nums">{{ $m->new_quantity }}</td>
                    <td class="py-2 pr-3 font-semibold tabular-nums {{ $m->difference >= 0 ? 'text-emerald-600' : 'text-red-600' }}">
