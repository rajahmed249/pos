<script>
(function() {
    window.syncReturnPrice = function() {
        var sel = document.getElementById('retProductSelect');
        var inp = document.getElementById('retPriceInput');
        if (!sel || !inp) return;
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.dataset.price) {
            inp.value = Number(opt.dataset.price || 0).toFixed(2);
        }
    };
    window.syncReturnPrice();
})();
</script>
@endsection
