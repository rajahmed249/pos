APP_NAME="Youth IT POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youthits_pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mail.youthit.com.bd
MAIL_PORT=465
MAIL_USERNAME=info@youthit.com.bd
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@youthit.com.bd
MAIL_FROM_NAME="${APP_NAME}"

SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_USERNAME=
SMS_SECRET_KEY=
SMS_SENDER_ID=
