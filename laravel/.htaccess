<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive directories and files
    RewriteRule ^(\.env|composer\.(json|lock)|artisan|app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Route requests cleanly into public/ (works at root domain and subfolders)
    RewriteCond %{REQUEST_URI} !public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
